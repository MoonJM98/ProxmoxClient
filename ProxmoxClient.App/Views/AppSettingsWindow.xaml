<Window x:Class="ProxmoxClient.App.Views.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
        xmlns:ic="clr-namespace:ProxmoxClient.App.Controls"
        xmlns:shared="clr-namespace:ProxmoxClient.App.Views.Shared"
        Style="{StaticResource ThemedWindow}"
        Title="{loc:Tr MainWindow_04}"
        Width="1040" Height="660" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                <ListBox x:Name="SettingsNavigation" Style="{StaticResource NavListBox}" ItemContainerStyle="{StaticResource NavListBoxItem}"
                         SelectedIndex="0" SelectionChanged="OnSettingsTabChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Content="{loc:Tr Settings_General}" />
                    <ListBoxItem Content="{loc:Tr MainWindow_09}" />
                    <ListBoxItem Content="{loc:Tr Settings_Sftp}" />
                </ListBox>
            </Border>
        <ScrollViewer x:Name="GeneralPanel" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,10">
                <TextBlock Text="{loc:Tr MainWindow_03}" Style="{StaticResource FormSection}" />
                <ic:FormRow x:Name="RowInterval" Label="{loc:Tr AppSettingsWindow_01}">
                    <TextBox x:Name="IntervalBox" ic:InputFilter.Mode="Integer" Width="140" HorizontalAlignment="Left" />
                </ic:FormRow>
                <ic:FormRow Label="{loc:Tr AppSettingsWindow_02}">
                    <CheckBox x:Name="AutoRefreshCheck" Content="{loc:Tr AppSettingsWindow_03}" Margin="0,6,0,0" />
                </ic:FormRow>

                <TextBlock Text="{loc:Tr AppSettingsWindow_04}" Style="{StaticResource FormSection}" />
                <ic:FormRow Label="{loc:Tr AppSettingsWindow_05}" Hint="{loc:Tr AppSettingsWindow_06}">
                    <ComboBox x:Name="LanguageBox" Width="200" HorizontalAlignment="Left" />
                </ic:FormRow>
                <ic:FormRow Label="{loc:Tr AppSettingsWindow_07}" Hint="{loc:Tr AppSettingsWindow_08}">
                    <ComboBox x:Name="ByteUnitBox" Width="200" HorizontalAlignment="Left" />
                </ic:FormRow>

            </StackPanel>
        </ScrollViewer>
        <StackPanel x:Name="ConsolePanel" Grid.Column="1" Margin="20,16" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr MainWindow_09}" Style="{StaticResource FormSection}" />
                <ic:FormRow Label="{loc:Tr AppSettingsWindow_09}" Hint="{loc:Tr AppSettingsWindow_10}">
                    <Button ic:IconAssist.Icon="{StaticResource IconSettings}" Content="{loc:Tr AppSettingsWindow_11}"
                            HorizontalAlignment="Left" Click="OnOpenConsoleSettings" />
                </ic:FormRow>
        </StackPanel>
        <shared:SftpProfilesEditor x:Name="SftpPanel" Grid.Column="1" Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button ic:IconAssist.Icon="{StaticResource IconSave}" x:Name="BtnSave"
                            Content="{loc:Tr AppSettingsWindow_12}"
                            Style="{StaticResource DialogPrimaryButton}" Click="OnSave" IsDefault="True" />
                    <Button x:Name="BtnClose" ic:IconAssist.Icon="{StaticResource IconX}" Content="{loc:Tr AppSettingsWindow_13}"
                            Style="{StaticResource DialogButton}" IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource DialogStatus}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
