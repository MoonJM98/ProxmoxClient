<Window x:Class="ProxmoxClient.App.Views.Storage.UploadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
        xmlns:ic="clr-namespace:ProxmoxClient.App.Controls"
        Style="{StaticResource ThemedWindow}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20,18,20,18">
        <TextBlock x:Name="FileText" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
        <ProgressBar x:Name="Bar" Height="16" Minimum="0" Maximum="100" />
        <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" ic:IconAssist.Icon="{StaticResource IconX}"
                    Content="{loc:Tr AppSettingsWindow_13}" Style="{StaticResource DialogButton}" Click="OnCancel" />
            <TextBlock x:Name="PercentText" VerticalAlignment="Center" Foreground="{StaticResource BrushDim}" />
        </DockPanel>
    </StackPanel>
</Window>
