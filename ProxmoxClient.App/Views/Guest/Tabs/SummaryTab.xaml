<UserControl x:Class="ProxmoxClient.App.Views.Guest.Tabs.SummaryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
             xmlns:ic="clr-namespace:ProxmoxClient.App.Controls"
             xmlns:c="clr-namespace:ProxmoxClient.App">

    <UserControl.Resources>
        <c:BytesHumanConverter x:Key="Bytes" />
        <c:UptimeConverter x:Key="Uptime" />
        <c:StatusToBrushConverter x:Key="StatusBrush" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">
            <!-- 이전·템플릿 변환·삭제(권한 있는 것만) -->
            <WrapPanel x:Name="ActionPanel" Margin="0,0,0,8" />

            <!-- 상태 요약 -->
            <Border Style="{StaticResource FormPanel}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr MainWindow_42}" Style="{StaticResource FormSection}" />
                    <DockPanel Margin="0,0,0,10">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr MainWindow_41}"
                                   Style="{StaticResource SummaryLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Node}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr MainWindow_47}"
                                   Style="{StaticResource SummaryLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CpuCount}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr MainWindow_21}"
                                   Style="{StaticResource SummaryLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding UptimeDisplaySeconds, Converter={StaticResource Uptime}}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr MainWindow_22}"
                                   Style="{StaticResource SummaryLabel}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Pool}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr MainWindow_23}"
                                   Style="{StaticResource SummaryLabel}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TagsText" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 사용량 -->
            <Border Style="{StaticResource FormPanel}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Tr MainWindow_56}" Style="{StaticResource FormSection}" />

                    <TextBlock Text="CPU" Margin="0,0,0,3" />
                    <ProgressBar x:Name="CpuBar" Height="16" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="CpuText" Foreground="{StaticResource BrushDim}" FontSize="11"
                               Margin="0,3,0,10" />

                    <TextBlock Text="{loc:Tr MainWindow_19}" Margin="0,0,0,3" />
                    <ProgressBar x:Name="MemBar" Height="16" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="MemText" Foreground="{StaticResource BrushDim}" FontSize="11"
                               Margin="0,3,0,10" />

                    <TextBlock Text="{loc:Tr MainWindow_20}" Margin="0,0,0,3" />
                    <ProgressBar x:Name="DiskBar" Height="16" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="DiskText" Foreground="{StaticResource BrushDim}" FontSize="11"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource DialogStatus}" ic:WindowFooter.Move="True" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
