<UserControl x:Class="ProxmoxClient.App.Views.Guest.Tabs.MonitorTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
             xmlns:ic="clr-namespace:ProxmoxClient.App.Controls">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Tr MonitorTab_Hint}" Foreground="{StaticResource BrushDim}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,10" />

        <TextBox Grid.Row="1" x:Name="OutputBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
                 FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" ic:IconAssist.Icon="{StaticResource IconPlay}" Margin="8,0,0,0"
                    Content="{loc:Tr MonitorTab_Run}" Click="OnRun" MinWidth="90" IsDefault="True" />
            <TextBox x:Name="CommandBox" FontFamily="Cascadia Mono, Consolas" KeyDown="OnCommandKeyDown" />
        </DockPanel>
    </Grid>
</UserControl>
