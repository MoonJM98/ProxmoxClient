<UserControl x:Class="ProxmoxClient.App.Views.Guest.Tabs.ConsoleTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
             xmlns:ic="clr-namespace:ProxmoxClient.App.Controls">

    <StackPanel Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
        <ic:PathIcon x:Name="KindIcon" Width="44" Height="44" HorizontalAlignment="Center"
                     Data="{StaticResource IconMonitor}" Margin="0,0,0,14" />
        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{StaticResource BrushDim}" Margin="0,0,0,18" />
        <Button x:Name="BtnOpen" ic:IconAssist.Icon="{StaticResource IconExternal}"
                Content="{loc:Tr ConsoleTab_Open}" Style="{StaticResource AccentButton}"
                HorizontalAlignment="Center" MinWidth="170" Click="OnOpenConsole" />
        <TextBlock x:Name="StatusText" Style="{StaticResource DialogStatus}" TextAlignment="Center"
                   Margin="0,14,0,0" />
    </StackPanel>
</UserControl>
