<UserControl x:Class="ProxmoxClient.App.Views.Guest.Tabs.SnapshotsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
             xmlns:ic="clr-namespace:ProxmoxClient.App.Controls"
             xmlns:c="clr-namespace:ProxmoxClient.App">
    <UserControl.Resources>
        <c:DateTimeLocalConverter x:Key="DateLocal" />
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="SnapshotGrid" Grid.Row="0" MinHeight="160"
                  ItemsSource="{Binding Snapshots}"
                  SelectedItem="{Binding SelectedSnapshot}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Tr MainWindow_40}" Binding="{Binding Name, Mode=OneWay}"
                                    Width="160" />
                <DataGridTextColumn Header="{loc:Tr SnapshotDialog_02}"
                                    Binding="{Binding SnapTimeUtc, Mode=OneWay, Converter={StaticResource DateLocal}}"
                                    Width="170" />
                <DataGridCheckBoxColumn Header="{loc:Tr SnapshotDialog_03}" Binding="{Binding HasRam, Mode=OneWay}"
                                        IsReadOnly="True" Width="80" ElementStyle="{StaticResource GridCheckBox}" />
                <DataGridTextColumn Header="{loc:Tr FirewallWindow_13}"
                                    Binding="{Binding Description, Mode=OneWay}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button ic:IconAssist.Icon="{StaticResource IconPencil}" Content="{loc:Tr SnapshotDialog_EditNote}"
                    Click="OnEditDescription" MinWidth="110" Margin="0,0,8,0" />
            <Button ic:IconAssist.Icon="{StaticResource IconUndo}" Content="{loc:Tr SnapshotDialog_04}"
                    Click="OnRollback" MinWidth="110" />
            <Button ic:IconAssist.Icon="{StaticResource IconTrash}" ic:IconAssist.Brush="{StaticResource BrushErr}"
                    Content="{loc:Tr SnapshotDialog_05}"
                    Style="{StaticResource DangerButton}" Click="OnDelete" MinWidth="110" Margin="8,0,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource FormPanel}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{loc:Tr SnapshotDialog_06}" Style="{StaticResource FormSection}" />
                <ic:FormRow Label="{loc:Tr MainWindow_40}" LabelWidth="90" Hint="{loc:Tr SnapshotDialog_07}">
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                </ic:FormRow>
                <ic:FormRow Label="{loc:Tr FirewallWindow_13}" LabelWidth="90">
                    <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" />
                </ic:FormRow>
                <DockPanel Margin="102,0,0,0">
                    <Button DockPanel.Dock="Right" ic:IconAssist.Icon="{StaticResource IconCamera}"
                            Content="{loc:Tr SnapshotDialog_08}"
                            Style="{StaticResource AccentButton}" Click="OnCreate" MinWidth="110" />
                    <CheckBox Content="{loc:Tr SnapshotDialog_09}" IsChecked="{Binding NewIncludeRam}"
                              VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Style="{StaticResource DialogStatus}"
                   Margin="0,10,0,0" />
    </Grid>
</UserControl>
