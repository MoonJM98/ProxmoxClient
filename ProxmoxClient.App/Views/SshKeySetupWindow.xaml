<Window x:Class="ProxmoxClient.App.Views.SshKeySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
        xmlns:ic="clr-namespace:ProxmoxClient.App.Controls"
        Style="{StaticResource ThemedWindow}" Title="{loc:Tr SshSetup_Title}"
        Width="860" Height="720" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource BrushDim}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TabControl x:Name="SetupTabs" Margin="16" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}">
            <TabItem Header="{loc:Tr SshSetup_RegistrationTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16" TextElement.FontWeight="Normal">
                        <TextBlock Text="{loc:Tr SshSetup_PrivateKey}" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="{loc:Tr Sftp_Browse}" Click="OnBrowseKey" Margin="8,0,0,0" />
                            <ComboBox x:Name="ExistingKeyChoice" IsEditable="True" IsTextSearchEnabled="False" />
                        </DockPanel>
                        <TextBlock Text="{loc:Tr SshSetup_ExistingKeyHint}" TextWrapping="Wrap" Foreground="{StaticResource BrushDim}" Margin="0,0,0,10" />
                        <Button Content="{loc:Tr SshSetup_ReadPublicKey}" Click="OnReadPublicKey" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Tr SshSetup_PublicKey}" Margin="0,0,0,4" />
                        <TextBox x:Name="PublicKeyBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="85"
                                 FontFamily="Cascadia Mono, Consolas, Courier New" VerticalScrollBarVisibility="Auto" Padding="8" />
                        <WrapPanel Margin="0,8,0,12">
                            <Button x:Name="CopyPublicKeyButton" Content="{loc:Tr SshSetup_CopyPublicKey}" Click="OnCopyPublicKey"
                                    ic:IconAssist.Icon="{StaticResource IconCopy}" IsEnabled="False" Margin="0,0,8,0" />
                            <Button x:Name="SavePublicKeyButton" Content="{loc:Tr SshSetup_SavePublicKey}" Click="OnSavePublicKey" IsEnabled="False" />
                        </WrapPanel>
                        <TextBlock x:Name="RegistrationDescription" TextWrapping="Wrap" Foreground="{StaticResource BrushDim}" Margin="0,0,0,10" />
                        <StackPanel x:Name="RegistrationCommands">
                            <TextBox x:Name="CommandBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" Height="205" Padding="8"
                                     FontFamily="Cascadia Mono, Consolas, Courier New" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                            <Button x:Name="CopyCommandButton" Click="OnCopyCommand"
                                    ic:IconAssist.Icon="{StaticResource IconCopy}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,12">
                                <TextBlock Text="{loc:Tr SshSetup_CopyCommand}" />
                            </Button>
                            <TextBlock Text="{loc:Tr SshSetup_PasteCommandHint}" TextWrapping="Wrap" Foreground="{StaticResource BrushDim}" Margin="0,0,0,8" />
                            <TextBlock Text="{loc:Tr SshSetup_RegistrationNote}" TextWrapping="Wrap" Foreground="{StaticResource BrushDim}" />
                        </StackPanel>
                        <TextBlock x:Name="CertificateDescription" Text="{loc:Tr SshSetup_CertificateNote}" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushDim}" Visibility="Collapsed" />
                        <Button Content="{loc:Tr SshSetup_OpenDocs}" Click="OnOpenDocs" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Tr SshSetup_GenerationTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16" TextElement.FontWeight="Normal">
                        <TextBlock Text="{loc:Tr SshSetup_GenerationHint}" TextWrapping="Wrap" Foreground="{StaticResource BrushDim}" Margin="0,0,0,16" />
                        <TextBlock Text="{loc:Tr SshSetup_KeyType}" Margin="0,0,0,4" />
                        <ComboBox x:Name="KeyTypeChoice" DisplayMemberPath="Label" SelectedValuePath="Type" SelectionChanged="OnKeyTypeChanged" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Tr SshSetup_NewPath}" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="{loc:Tr Sftp_Browse}" Click="OnChooseNewPath" Margin="8,0,0,0" />
                            <TextBox x:Name="NewKeyPathBox" />
                        </DockPanel>
                        <StackPanel x:Name="GenerationPassphrasePanel">
                            <TextBlock Text="{loc:Tr SshSetup_NewPassphrase}" Margin="0,0,0,4" /><PasswordBox x:Name="NewPassphraseBox" Margin="0,0,0,12" />
                            <TextBlock Text="{loc:Tr SshSetup_ConfirmPassphrase}" Margin="0,0,0,4" /><PasswordBox x:Name="ConfirmPassphraseBox" Margin="0,0,0,12" />
                            <TextBlock Text="{loc:Tr SshSetup_PassphraseHint}" TextWrapping="Wrap" Foreground="{StaticResource BrushDim}" Margin="0,0,0,12" />
                        </StackPanel>
                        <TextBlock x:Name="Ed25519GenerationHint" Text="{loc:Tr SshSetup_Ed25519Hint}" Visibility="Collapsed"
                                   TextWrapping="Wrap" Foreground="{StaticResource BrushDim}" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Tr SshSetup_Comment}" Margin="0,0,0,4" /><TextBox x:Name="CommentBox" Margin="0,0,0,16" />
                        <Button Content="{loc:Tr SshSetup_Generate}" Click="OnGenerate" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Tr Sftp_Close}" Click="OnClose" Style="{StaticResource DialogButton}" IsCancel="True" />
                <TextBlock x:Name="StatusText" Style="{StaticResource DialogStatus}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
