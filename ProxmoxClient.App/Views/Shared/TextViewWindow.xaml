<Window x:Class="ProxmoxClient.App.Views.Shared.TextViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ThemedWindow}"
        Width="820" Height="560" MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <TextBox x:Name="Body" Margin="16" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
             TextWrapping="NoWrap" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
</Window>
