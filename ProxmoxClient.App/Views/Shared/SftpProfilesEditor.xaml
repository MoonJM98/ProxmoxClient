<UserControl x:Class="ProxmoxClient.App.Views.Shared.SftpProfilesEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxmoxClient.App.Localization">
    <UserControl.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource BrushDim}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TabControl x:Name="Tabs" Margin="16" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}">
            <TabItem Header="{loc:Tr Sftp_Connections}">
                <Grid Margin="10" TextElement.FontWeight="Normal">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{loc:Tr Sftp_Add}" Click="OnNewConnection" Margin="0,0,8,0" />
                            <Button Content="{loc:Tr Sftp_Delete}" Click="OnDeleteConnection" />
                        </StackPanel>
                        <ListBox x:Name="ConnectionList" SelectionChanged="OnConnectionSelected" />
                    </DockPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Tr Sftp_ProfileName}" Margin="0,0,0,4" /><TextBox x:Name="ConnectionName" Margin="0,0,0,10" />
                        <TextBlock Text="{loc:Tr Sftp_Host}" Margin="0,0,0,4" /><TextBox x:Name="HostBox" Margin="0,0,0,10" />
                        <TextBlock Text="{loc:Tr Sftp_Port}" Margin="0,0,0,4" /><TextBox x:Name="PortBox" Text="22" Margin="0,0,0,10" />
                        <TextBlock Text="{loc:Tr Sftp_Account}" Margin="0,0,0,4" />
                        <ComboBox x:Name="AccountChoice" Margin="0,0,0,10" />
                        <Button Content="{loc:Tr Sftp_ManageAccounts}" Click="OnManageAccounts" HorizontalAlignment="Left" Margin="0,0,0,16" />
                        <Button Content="{loc:Tr Sftp_SaveProfile}" Click="OnSaveConnection" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{loc:Tr Sftp_Accounts}">
                <Grid Margin="10" TextElement.FontWeight="Normal">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{loc:Tr Sftp_Add}" Click="OnNewAccount" Margin="0,0,8,0" />
                            <Button Content="{loc:Tr Sftp_Delete}" Click="OnDeleteAccount" />
                        </StackPanel>
                        <ListBox x:Name="AccountList" SelectionChanged="OnAccountSelected" />
                    </DockPanel>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{loc:Tr Sftp_ProfileName}" Margin="0,0,0,4" /><TextBox x:Name="AccountName" Margin="0,0,0,10" />
                        <TextBlock Text="{loc:Tr Sftp_User}" Margin="0,0,0,4" /><TextBox x:Name="UserBox" Margin="0,0,0,10" />
                        <TextBlock Text="{loc:Tr Sftp_Authentication}" Margin="0,0,0,4" />
                        <ComboBox x:Name="AuthenticationChoice" DisplayMemberPath="Label" SelectedValuePath="Mode" SelectionChanged="OnAuthenticationChanged" Margin="0,0,0,10" />
                        <Button x:Name="KeySetupButton" Content="{loc:Tr Sftp_KeySetup}" Click="OnKeySetup" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <StackPanel x:Name="PrivateKeyPanel" Visibility="Collapsed">
                            <TextBlock Text="{loc:Tr Sftp_PrivateKeyPath}" Margin="0,0,0,4" />
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="{loc:Tr Sftp_Browse}" Click="OnBrowsePrivateKey" Margin="8,0,0,0" />
                                <TextBox x:Name="PrivateKeyBox" VerticalContentAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel x:Name="CertificatePanel" Visibility="Collapsed">
                            <TextBlock Text="{loc:Tr Sftp_CertificatePath}" Margin="0,0,0,4" />
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="{loc:Tr Sftp_Browse}" Click="OnBrowseCertificate" Margin="8,0,0,0" />
                                <TextBox x:Name="CertificateBox" VerticalContentAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{loc:Tr Sftp_CertificateHint}" TextWrapping="Wrap" Foreground="{StaticResource BrushDim}" Margin="0,0,0,10" />
                        </StackPanel>
                        <TextBlock x:Name="DefaultKeysHint" Text="{loc:Tr Sftp_DefaultKeysHint}" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource BrushDim}" Margin="0,0,0,10" />
                        <TextBlock x:Name="SecretLabel" Text="{loc:Tr Sftp_Password}" Margin="0,0,0,4" /><PasswordBox x:Name="PasswordBox" Margin="0,0,0,6" />
                        <TextBlock x:Name="SecretHint" Text="{loc:Tr Sftp_AccountPasswordHint}" TextWrapping="Wrap" Foreground="{StaticResource BrushDim}" Margin="0,0,0,10" />
                        <CheckBox x:Name="RememberBox" Content="{loc:Tr Sftp_Remember}" Margin="0,0,0,10" />
                        <TextBlock x:Name="PasswordState" Foreground="{StaticResource BrushDim}" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button Content="{loc:Tr Sftp_SaveProfile}" Click="OnSaveAccount" Margin="0,0,8,0" />
                            <Button x:Name="ForgetSecretButton" Content="{loc:Tr Sftp_ForgetPassword}" Click="OnForgetPassword" />
                        </WrapPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="1" x:Name="StatusText" Style="{StaticResource DialogStatus}" Margin="20,0,20,12" />
        <Border x:Name="ActionFooter" Grid.Row="2" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Tr Sftp_UseForGuest}" Click="OnUseConnection">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DialogPrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=Tabs}" Value="1">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{loc:Tr Sftp_Close}" Style="{StaticResource DialogButton}" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

