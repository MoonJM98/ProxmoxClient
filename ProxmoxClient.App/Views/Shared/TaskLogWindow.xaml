<Window x:Class="ProxmoxClient.App.Views.Shared.TaskLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
        xmlns:ic="clr-namespace:ProxmoxClient.App.Controls"
        Style="{StaticResource ThemedWindow}"
        Width="860" Height="580" MinWidth="460" MinHeight="280"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" x:Name="StopButton" ic:IconAssist.Icon="{StaticResource IconSquare}"
                    Content="{loc:Tr TasksTab_Stop}" Click="OnStop" MinWidth="80" IsEnabled="False" />
            <Button DockPanel.Dock="Right" x:Name="DownloadButton" ic:IconAssist.Icon="{StaticResource IconDownload}"
                    Content="{loc:Tr TaskLog_Download}" Click="OnDownload" MinWidth="96" />
            <TextBlock x:Name="StateText" Margin="12,0" VerticalAlignment="Center"
                       Foreground="{StaticResource BrushDim}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <TextBox Grid.Row="1" x:Name="Body" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 TextWrapping="NoWrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="2" x:Name="StatusText" Style="{StaticResource DialogStatus}" Margin="0,10,0,0" />
    </Grid>
</Window>
