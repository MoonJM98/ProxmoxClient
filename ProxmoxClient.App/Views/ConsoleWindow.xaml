<Window x:Class="ProxmoxClient.App.Views.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
        xmlns:ic="clr-namespace:ProxmoxClient.App.Controls"
        Style="{StaticResource ThemedWindow}"
        Title="{loc:Tr MainWindow_09}"
        Width="980" Height="700" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" Focusable="True"
        PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
    <Window.Resources>
        <Style TargetType="Border" x:Key="ToolbarBorder">
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{StaticResource BrushPanel}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarBorder}">
            <WrapPanel>
                <!-- 게스트 전원: 상태에 맞는 버튼만 표시(GuestPowerVisibility), DataContext = 게스트 -->
                <StackPanel x:Name="PowerPanel" Orientation="Horizontal">
                    <Button ic:IconAssist.Icon="{StaticResource IconPlay}"
                            ic:IconAssist.Brush="{StaticResource BrushOk}" Content="{loc:Tr MainWindow_33}"
                            ic:GuestPowerVisibility.Action="Start" ic:GuestPowerVisibility.Guest="{Binding}"
                            Margin="0,0,6,0" Click="OnPowerAction" />
                    <!-- 웹 UI 처럼 [종료 | ▾] — 정지·재부팅·리셋 등은 ▾ 안에(목록이 게스트 상태에 맞게 숨긴다) -->
                    <ic:SplitButton ic:IconAssist.Icon="{StaticResource IconPower}"
                                    ic:IconAssist.Brush="{StaticResource BrushWarn}" Content="{loc:Tr MainWindow_35}"
                                    ic:GuestPowerVisibility.Action="Stop" ic:GuestPowerVisibility.Guest="{Binding}"
                                    Margin="0,0,6,0" Click="OnShutdownClick">
                        <ic:SplitButton.DropDownMenu>
                            <ContextMenu>
                                <MenuItem ic:IconAssist.Icon="{StaticResource IconRotate}" Header="{loc:Tr MainWindow_34}"
                                          ic:GuestPowerVisibility.Action="Reboot" ic:GuestPowerVisibility.Guest="{Binding}"
                                          Click="OnPowerAction" />
                                <MenuItem ic:IconAssist.Icon="{StaticResource IconPause}" Header="{loc:Tr MainWindow_11}"
                                          ic:GuestPowerVisibility.Action="Suspend" ic:GuestPowerVisibility.Guest="{Binding}"
                                          Click="OnPowerAction" />
                                <MenuItem ic:IconAssist.Icon="{StaticResource IconResume}" Header="{loc:Tr MainWindow_12}"
                                          ic:GuestPowerVisibility.Action="Resume" ic:GuestPowerVisibility.Guest="{Binding}"
                                          Click="OnPowerAction" />
                                <MenuItem ic:IconAssist.Icon="{StaticResource IconSquare}"
                                          ic:IconAssist.Brush="{StaticResource BrushErr}" Header="{loc:Tr MainWindow_36}"
                                          ic:GuestPowerVisibility.Action="Stop" ic:GuestPowerVisibility.Guest="{Binding}"
                                          Click="OnPowerAction" />
                                <MenuItem ic:IconAssist.Icon="{StaticResource IconRotate}" Header="{loc:Tr GuestPower_Reset}"
                                          ic:GuestPowerVisibility.Action="Reset" ic:GuestPowerVisibility.Guest="{Binding}"
                                          Click="OnPowerAction" />
                            </ContextMenu>
                        </ic:SplitButton.DropDownMenu>
                    </ic:SplitButton>
                    <Border Width="1" Background="{StaticResource BrushBorder}" Margin="4,4,10,4" />
                </StackPanel>
                <Button ic:IconAssist.Icon="{StaticResource IconRefresh}" x:Name="BtnConnect"
                        Content="{loc:Tr ConsoleWindow_02}" MinWidth="78" Margin="0,0,6,0" Click="OnReconnect" />
                <Button ic:IconAssist.Icon="{StaticResource IconLogOut}" x:Name="BtnDisconnect"
                        Content="{loc:Tr MainWindow_02}" MinWidth="84" Margin="0,0,6,0" Click="OnDisconnect" />
                <Separator Margin="2,0" />
                <!-- 특수 키 ▾ — noVNC 의 키 모음: Ctrl·Alt·Shift·Win 은 누른 채 유지(체크), Tab·Esc·Ctrl+Alt+Del 은 한 번 -->
                <Button ic:IconAssist.Icon="{StaticResource IconKeyboard}" x:Name="BtnKeys"
                        Content="{loc:Tr Console_SpecialKeys}" ic:IconAssist.Dropdown="True"
                        Margin="6,0,6,0" Click="OnKeysMenu" ToolTip="{loc:Tr Console_SpecialKeysHint}" />
                <Popup x:Name="KeysPopup" PlacementTarget="{Binding ElementName=BtnKeys}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="KeyCtrl" Tag="Ctrl" Content="Ctrl" Style="{StaticResource KeyToggle}"
                                          Checked="OnStickyKeyToggled" Unchecked="OnStickyKeyToggled" />
                            <ToggleButton x:Name="KeyAlt" Tag="Alt" Content="Alt" Style="{StaticResource KeyToggle}"
                                          Checked="OnStickyKeyToggled" Unchecked="OnStickyKeyToggled" />
                            <ToggleButton x:Name="KeyShift" Tag="Shift" Content="Shift" Style="{StaticResource KeyToggle}"
                                          Checked="OnStickyKeyToggled" Unchecked="OnStickyKeyToggled" />
                            <ToggleButton x:Name="KeyWin" Tag="Win" Content="Win" Style="{StaticResource KeyToggle}"
                                          Checked="OnStickyKeyToggled" Unchecked="OnStickyKeyToggled" />
                            <Border Width="1" Background="{StaticResource BrushBorder}" Margin="2,2,8,2" />
                            <Button Tag="Tab" Content="Tab" Padding="10,5" Margin="0,0,6,0" Click="OnTapKey" />
                            <Button Tag="Esc" Content="Esc" Padding="10,5" Margin="0,0,6,0" Click="OnTapKey" />
                            <Button Tag="CtrlAltDel" Content="Ctrl+Alt+Del" Padding="10,5" Click="OnTapKey" />
                        </StackPanel>
                    </Border>
                </Popup>
                <Button ic:IconAssist.Icon="{StaticResource IconClipboard}" x:Name="BtnClip"
                        Content="{loc:Tr ConsoleWindow_03}" MinWidth="100" Margin="0,0,6,0" Click="OnSendClipboard"
                        ToolTipService.ShowOnDisabled="True" />
                <Separator Margin="2,0" />
                <Button ic:IconAssist.Icon="{StaticResource IconMaximize}" x:Name="BtnScale"
                        Content="{loc:Tr ConsoleWindow_04}" MinWidth="92" Margin="6,0,6,0" Click="OnToggleScale" />
                <!-- SPICE 는 디스플레이가 SPICE(qxl) 일 때만 — 연결 뒤 설정을 읽고 보인다 -->
                <Button ic:IconAssist.Icon="{StaticResource IconExternal}" x:Name="BtnSpice" Visibility="Collapsed"
                        Content="{loc:Tr ConsoleWindow_05}" MinWidth="110" Style="{StaticResource AccentButton}"
                        Click="OnOpenSpice" />
                <!-- 게스트 파일(게스트 에이전트) — 파일 창을 따로 연다 -->
                <ic:SplitButton x:Name="BtnFiles" ic:IconAssist.Icon="{StaticResource IconFolder}"
                        Content="{loc:Tr GuestFiles_Toggle}"
                        Margin="6,0,0,0" Click="OnOpenFiles" ToolTip="{loc:Tr GuestFiles_ToggleTipVm}">
                    <ic:SplitButton.DropDownMenu>
                        <ContextMenu>
                            <MenuItem x:Name="FilesAgent" Header="{loc:Tr Sftp_Agent}" Click="OnFilesMethod" />
                            <MenuItem x:Name="FilesSftp" Header="SFTP" Click="OnFilesMethod" />
                            <Separator />
                            <MenuItem x:Name="FilesConfigure" Header="{loc:Tr Sftp_Settings}" Click="OnFilesMethod" />
                        </ContextMenu>
                    </ic:SplitButton.DropDownMenu>
                </ic:SplitButton>
                <Button ic:IconAssist.Icon="{StaticResource IconSettings}" x:Name="BtnSettings"
                        Content="{loc:Tr MainWindow_04}" MinWidth="80" Margin="6,0,0,0" Click="OnOpenSettings" />
            </WrapPanel>
        </Border>

        <!-- 파일을 콘솔 화면에 끌어다 놓으면 파일 창을 열고 지금 폴더로 올린다 -->
        <ScrollViewer Grid.Row="1" x:Name="ConsoleScroll" Background="#000000" AllowDrop="True"
                      DragEnter="OnScreenDragOver" DragOver="OnScreenDragOver" Drop="OnScreenDrop"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid x:Name="ScreenHost">
                <Image x:Name="ScreenImage" Stretch="Uniform" StretchDirection="DownOnly"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       MouseEnter="OnImageMouseEnter" MouseLeave="OnImageMouseLeave"
                       MouseDown="OnImageMouseDown" MouseUp="OnImageMouseUp"
                       MouseMove="OnImageMouseMove" MouseWheel="OnImageMouseWheel" />
                <!-- "둘 다 보기" 에서 게스트가 보낸 커서 모양 — PC 화살표 아래 마우스 위치에 겹쳐 그린다 -->
                <Image x:Name="CursorImage" IsHitTestVisible="False" Visibility="Collapsed" Stretch="Fill"
                       HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="CursorTransform" />
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </ScrollViewer>

        <!-- GPU 로 바로 그리기 — 스크롤 뷰포트 크기의 자식 창을 화면 위에 겹친다(입력은 아래 Image 가 받는다) -->
        <Grid Grid.Row="1" x:Name="DirectSlot" HorizontalAlignment="Left" VerticalAlignment="Top"
              IsHitTestVisible="False" />

        <ic:GuestStoppedPanel Grid.Row="1" x:Name="StoppedPanel" Visibility="Collapsed" />

        <Border Grid.Row="2" Style="{StaticResource ToolbarBorder}">
            <DockPanel>
                <!-- 게스트에 눌려 있는 조합키 — 특수 키로 누른 채 둔 것과 PC 키보드로 누르고 있는 것 모두 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" ToolTip="{loc:Tr Console_ModifiersHint}">
                    <Border x:Name="ModCtrl" Style="{StaticResource ModifierTag}"><TextBlock Text="Ctrl" /></Border>
                    <Border x:Name="ModAlt" Style="{StaticResource ModifierTag}"><TextBlock Text="Alt" /></Border>
                    <Border x:Name="ModShift" Style="{StaticResource ModifierTag}"><TextBlock Text="Shift" /></Border>
                    <Border x:Name="ModWin" Style="{StaticResource ModifierTag}"><TextBlock Text="Win" /></Border>
                </StackPanel>
                <TextBlock x:Name="StateText" Text="{loc:Tr ConsoleWindow_06}" Foreground="{StaticResource BrushDim}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
