<Window x:Class="ProxmoxClient.App.Views.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
        xmlns:ic="clr-namespace:ProxmoxClient.App.Controls"
        Style="{StaticResource ThemedWindow}"
        Title="{loc:Tr MainWindow_09}"
        Width="980" Height="700" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" Focusable="True"
        PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
    <Window.Resources>
        <Style TargetType="Border" x:Key="ToolbarBorder">
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{StaticResource BrushPanel}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarBorder}">
            <WrapPanel>
                <!-- 게스트 전원: 상태에 맞는 버튼만 표시(GuestPowerVisibility), DataContext = 게스트 -->
                <StackPanel x:Name="PowerPanel" Orientation="Horizontal">
                    <Button ic:IconAssist.Icon="{StaticResource IconPlay}"
                            ic:IconAssist.Brush="{StaticResource BrushOk}" Content="{loc:Tr MainWindow_33}"
                            ic:GuestPowerVisibility.Action="Start" ic:GuestPowerVisibility.Guest="{Binding}"
                            Margin="0,0,6,0" Click="OnPowerAction" />
                    <Button ic:IconAssist.Icon="{StaticResource IconPower}"
                            ic:IconAssist.Brush="{StaticResource BrushWarn}" Content="{loc:Tr MainWindow_35}"
                            ic:GuestPowerVisibility.Action="Shutdown" ic:GuestPowerVisibility.Guest="{Binding}"
                            Margin="0,0,6,0" Click="OnPowerAction" />
                    <Button ic:IconAssist.Icon="{StaticResource IconSquare}"
                            ic:IconAssist.Brush="{StaticResource BrushErr}" Content="{loc:Tr BackupWindow_08}"
                            ToolTip="{loc:Tr ConsoleWindow_01}" ic:GuestPowerVisibility.Action="Stop"
                            ic:GuestPowerVisibility.Guest="{Binding}" Margin="0,0,6,0" Click="OnPowerAction" />
                    <Button ic:IconAssist.Icon="{StaticResource IconRotate}" Content="{loc:Tr MainWindow_34}"
                            ic:GuestPowerVisibility.Action="Reboot" ic:GuestPowerVisibility.Guest="{Binding}"
                            Margin="0,0,6,0" Click="OnPowerAction" />
                    <Border Width="1" Background="{StaticResource BrushBorder}" Margin="4,4,10,4" />
                </StackPanel>
                <Button ic:IconAssist.Icon="{StaticResource IconRefresh}" x:Name="BtnConnect"
                        Content="{loc:Tr ConsoleWindow_02}" MinWidth="78" Margin="0,0,6,0" Click="OnReconnect" />
                <Button ic:IconAssist.Icon="{StaticResource IconLogOut}" x:Name="BtnDisconnect"
                        Content="{loc:Tr MainWindow_02}" MinWidth="84" Margin="0,0,6,0" Click="OnDisconnect" />
                <Separator Margin="2,0" />
                <Button ic:IconAssist.Icon="{StaticResource IconKeyboard}" x:Name="BtnCad" Content="Ctrl+Alt+Del"
                        MinWidth="96" Margin="6,0,6,0" Click="OnCtrlAltDel" />
                <Button ic:IconAssist.Icon="{StaticResource IconClipboard}" x:Name="BtnClip"
                        Content="{loc:Tr ConsoleWindow_03}" MinWidth="100" Margin="0,0,6,0" Click="OnSendClipboard" />
                <Separator Margin="2,0" />
                <Button ic:IconAssist.Icon="{StaticResource IconMaximize}" x:Name="BtnScale"
                        Content="{loc:Tr ConsoleWindow_04}" MinWidth="92" Margin="6,0,6,0" Click="OnToggleScale" />
                <Button ic:IconAssist.Icon="{StaticResource IconExternal}" x:Name="BtnSpice"
                        Content="{loc:Tr ConsoleWindow_05}" MinWidth="110" Style="{StaticResource AccentButton}"
                        Click="OnOpenSpice" />
                <Button ic:IconAssist.Icon="{StaticResource IconSettings}" x:Name="BtnSettings"
                        Content="{loc:Tr MainWindow_04}" MinWidth="80" Margin="6,0,0,0" Click="OnOpenSettings" />
            </WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="1" x:Name="ConsoleScroll" Background="#000000"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid>
                <Image x:Name="ScreenImage" Stretch="Uniform" StretchDirection="DownOnly" Cursor="None"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       MouseEnter="OnImageMouseEnter" MouseLeave="OnImageMouseLeave"
                       MouseDown="OnImageMouseDown" MouseUp="OnImageMouseUp"
                       MouseMove="OnImageMouseMove" MouseWheel="OnImageMouseWheel" />
                <Image x:Name="CursorImage" IsHitTestVisible="False" Visibility="Collapsed">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="CursorTransform" />
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </ScrollViewer>

        <ic:GuestStoppedPanel Grid.Row="1" x:Name="StoppedPanel" Visibility="Collapsed" />

        <Border Grid.Row="2" Style="{StaticResource ToolbarBorder}">
            <TextBlock x:Name="StateText" Text="{loc:Tr ConsoleWindow_06}" Foreground="{StaticResource BrushDim}" />
        </Border>
    </Grid>
</Window>