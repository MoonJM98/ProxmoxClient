<Window x:Class="ProxmoxClient.App.Views.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
        xmlns:ic="clr-namespace:ProxmoxClient.App.Controls"
        xmlns:term="clr-namespace:Microsoft.Terminal.Wpf;assembly=Microsoft.Terminal.Wpf"
        Style="{StaticResource ThemedWindow}"
        Title="{loc:Tr TerminalWindow_01}"
        Width="1000" Height="640" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="None" KeyboardNavigation.DirectionalNavigation="None"
        KeyboardNavigation.ControlTabNavigation="None">
    <!-- 터미널은 네이티브 창(HwndHost)이라 WPF 키보드 이동이 Tab·방향키를 먼저 가져가 포커스를 옮긴다 —
         창 전체에서 끄면 그 키가 터미널(셸 자동 완성·명령 기록)로 간다 -->
    <Window.Resources>
        <Style TargetType="Border" x:Key="ToolbarBorder">
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{StaticResource BrushPanel}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ToolbarBorder}">
            <DockPanel>
                <Button DockPanel.Dock="Right" ic:IconAssist.Icon="{StaticResource IconSettings}" x:Name="BtnSettings"
                        Content="{loc:Tr MainWindow_04}" MinWidth="80" Click="OnOpenSettings" />
                <StackPanel Orientation="Horizontal">
                    <!-- 게스트 전원: 상태에 맞는 버튼만 표시(GuestPowerVisibility), DataContext = 게스트 -->
                    <StackPanel x:Name="PowerPanel" Orientation="Horizontal">
                        <Button ic:IconAssist.Icon="{StaticResource IconPlay}"
                                ic:IconAssist.Brush="{StaticResource BrushOk}" Content="{loc:Tr MainWindow_33}"
                                ic:GuestPowerVisibility.Action="Start" ic:GuestPowerVisibility.Guest="{Binding}"
                                Margin="0,0,6,0" Click="OnPowerAction" />
                        <!-- 웹 UI 처럼 [종료 | ▾] — 정지·재부팅·리셋 등은 ▾ 안에(목록이 게스트 상태에 맞게 숨긴다) -->
                        <ic:SplitButton ic:IconAssist.Icon="{StaticResource IconPower}"
                                        ic:IconAssist.Brush="{StaticResource BrushWarn}" Content="{loc:Tr MainWindow_35}"
                                        ic:GuestPowerVisibility.Action="Stop" ic:GuestPowerVisibility.Guest="{Binding}"
                                        Margin="0,0,6,0" Click="OnShutdownClick">
                            <ic:SplitButton.DropDownMenu>
                                <ContextMenu>
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconRotate}" Header="{loc:Tr MainWindow_34}"
                                              ic:GuestPowerVisibility.Action="Reboot" ic:GuestPowerVisibility.Guest="{Binding}"
                                              Click="OnPowerAction" />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconPause}" Header="{loc:Tr MainWindow_11}"
                                              ic:GuestPowerVisibility.Action="Suspend" ic:GuestPowerVisibility.Guest="{Binding}"
                                              Click="OnPowerAction" />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconResume}" Header="{loc:Tr MainWindow_12}"
                                              ic:GuestPowerVisibility.Action="Resume" ic:GuestPowerVisibility.Guest="{Binding}"
                                              Click="OnPowerAction" />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconSquare}"
                                              ic:IconAssist.Brush="{StaticResource BrushErr}" Header="{loc:Tr MainWindow_36}"
                                              ic:GuestPowerVisibility.Action="Stop" ic:GuestPowerVisibility.Guest="{Binding}"
                                              Click="OnPowerAction" />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconRotate}" Header="{loc:Tr GuestPower_Reset}"
                                              ic:GuestPowerVisibility.Action="Reset" ic:GuestPowerVisibility.Guest="{Binding}"
                                              Click="OnPowerAction" />
                                </ContextMenu>
                            </ic:SplitButton.DropDownMenu>
                        </ic:SplitButton>
                        <Border Width="1" Background="{StaticResource BrushBorder}" Margin="4,4,10,4" />
                    </StackPanel>
                    <Button ic:IconAssist.Icon="{StaticResource IconRefresh}" x:Name="BtnReconnect"
                            Content="{loc:Tr ConsoleWindow_02}"
                            MinWidth="78" Margin="0,0,6,0" Click="OnReconnect" />
                    <Button ic:IconAssist.Icon="{StaticResource IconLogOut}" x:Name="BtnDisconnect"
                            Content="{loc:Tr MainWindow_02}"
                            MinWidth="84" Margin="0,0,6,0" Click="OnDisconnect" />
                    <Border Width="1" Background="{StaticResource BrushBorder}" Margin="4,4,10,4" />
                    <Button ic:IconAssist.Icon="{StaticResource IconCopy}" x:Name="BtnCopy"
                            Content="{loc:Tr TerminalWindow_02}"
                            MinWidth="72" Margin="0,0,6,0" Click="OnCopy" ToolTip="{loc:Tr TerminalWindow_03}" />
                    <Button ic:IconAssist.Icon="{StaticResource IconClipboard}" x:Name="BtnPaste"
                            Content="{loc:Tr TerminalWindow_04}"
                            MinWidth="90" Click="OnPaste" ToolTip="{loc:Tr TerminalWindow_05}" />
                    <!-- CT 파일(따로 뜨는 파일 창) — CT 에서만 보인다 -->
                    <Border x:Name="FilesSeparator" Width="1" Background="{StaticResource BrushBorder}"
                            Margin="10,4,4,4" Visibility="Collapsed" />
                    <ic:SplitButton x:Name="BtnFiles" ic:IconAssist.Icon="{StaticResource IconFolder}"
                            Content="{loc:Tr GuestFiles_Toggle}"
                            Visibility="Collapsed" Margin="6,0,0,0" Click="OnOpenFiles"
                            ToolTip="{loc:Tr GuestFiles_ToggleTip}">
                        <ic:SplitButton.DropDownMenu>
                            <ContextMenu>
                                <MenuItem x:Name="FilesNodeShell" Header="{loc:Tr Sftp_Container}" Click="OnFilesMethod" />
                                <MenuItem x:Name="FilesSftp" Header="SFTP" Click="OnFilesMethod" />
                                <Separator />
                                <MenuItem x:Name="FilesConfigure" Header="{loc:Tr Sftp_Settings}" Click="OnFilesMethod" />
                            </ContextMenu>
                        </ic:SplitButton.DropDownMenu>
                    </ic:SplitButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" x:Name="TerminalHost" Background="#0C0C0C" Padding="6,4">
            <term:TerminalControl x:Name="Terminal" Focusable="True" />
        </Border>

        <!-- 네이티브 터미널 창 위에는 WPF 를 겹쳐 그릴 수 없으므로(airspace) 표시 시 TerminalHost 를 숨긴다 -->
        <ic:GuestStoppedPanel Grid.Row="1" x:Name="StoppedPanel" Visibility="Collapsed" />

        <Border Grid.Row="2" Style="{StaticResource ToolbarBorder}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StateText" Text="{loc:Tr ConsoleWindow_06}" Foreground="{StaticResource BrushDim}" />
        </Border>
    </Grid>
</Window>
