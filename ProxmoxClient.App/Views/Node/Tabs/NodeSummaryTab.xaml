<UserControl x:Class="ProxmoxClient.App.Views.Node.Tabs.NodeSummaryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ProxmoxClient.App.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">
            <!-- 전원·일괄 작업(권한 있는 것만) -->
            <WrapPanel x:Name="ActionPanel" Margin="0,0,0,8" />

            <Border Style="{StaticResource FormPanel}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr MainWindow_NodeDetail}" Style="{StaticResource FormSection}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr MainWindow_46}"
                                   Style="{StaticResource SummaryLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="KernelText" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr MainWindow_47}"
                                   Style="{StaticResource SummaryLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CoresText" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr MainWindow_48}"
                                   Style="{StaticResource SummaryLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LoadText" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr MainWindow_21}"
                                   Style="{StaticResource SummaryLabel}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UptimeText" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FormPanel}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Tr MainWindow_56}" Style="{StaticResource FormSection}" />

                    <TextBlock Text="CPU" Margin="0,0,0,3" />
                    <ProgressBar x:Name="CpuBar" Height="16" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="CpuText" Foreground="{StaticResource BrushDim}" FontSize="11" Margin="0,3,0,10" />

                    <TextBlock Text="{loc:Tr MainWindow_19}" Margin="0,0,0,3" />
                    <ProgressBar x:Name="MemBar" Height="16" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="MemText" Foreground="{StaticResource BrushDim}" FontSize="11" Margin="0,3,0,10" />

                    <TextBlock Text="{loc:Tr MainWindow_50}" Margin="0,0,0,3" />
                    <ProgressBar x:Name="SwapBar" Height="16" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="SwapText" Foreground="{StaticResource BrushDim}" FontSize="11" Margin="0,3,0,10" />

                    <TextBlock Text="{loc:Tr MainWindow_51}" Margin="0,0,0,3" />
                    <ProgressBar x:Name="RootBar" Height="16" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="RootText" Foreground="{StaticResource BrushDim}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource DialogStatus}" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
