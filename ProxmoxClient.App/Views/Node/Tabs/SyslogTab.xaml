<UserControl x:Class="ProxmoxClient.App.Views.Node.Tabs.SyslogTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
             xmlns:ic="clr-namespace:ProxmoxClient.App.Controls">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" ic:IconAssist.Icon="{StaticResource IconRefresh}"
                    ic:RefreshButton.IsRefresh="True" Content="{loc:Tr MainWindow_03}" Click="OnRefresh" MinWidth="96" />
            <ic:InfoTip Text="{loc:Tr SyslogTab_Hint}" Margin="0" />
        </DockPanel>

        <!-- 로그는 고정폭 글꼴로 — 열 맞춤이 무너지면 읽기 어렵다 -->
        <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
                 FontSize="12" TextWrapping="NoWrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

        <TextBlock Grid.Row="2" x:Name="StatusText" Style="{StaticResource DialogStatus}" ic:WindowFooter.Move="True" Margin="0,10,0,0" />
    </Grid>
</UserControl>
