<Window x:Class="ProxmoxClient.App.Views.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
        xmlns:ic="clr-namespace:ProxmoxClient.App.Controls"
        xmlns:c="clr-namespace:ProxmoxClient.App"
        Style="{StaticResource ThemedWindow}"
        Title="{loc:Tr ProfileDialog_01}"
        Width="660" SizeToContent="Height" MaxHeight="800" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <c:EnumToBoolConverter x:Key="EnumToBool" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,10">

                <TextBlock Text="{loc:Tr CreateGuestWindow_02}" Style="{StaticResource FormSection}" />
                <ic:FormRow Label="{loc:Tr ProfileDialog_02}">
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </ic:FormRow>
                <ic:FormRow Label="{loc:Tr ProfileDialog_03}">
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                </ic:FormRow>
                <ic:FormRow Label="{loc:Tr FirewallWindow_11}" Hint="{loc:Tr ProfileDialog_04}">
                    <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                             ic:InputFilter.Mode="Integer"
                             Width="140" HorizontalAlignment="Left" />
                </ic:FormRow>
                <ic:FormRow Label="{loc:Tr ProfileDialog_05}" Hint="{loc:Tr ProfileDialog_06}">
                    <StackPanel>
                        <CheckBox Content="{loc:Tr ProfileDialog_07}" IsChecked="{Binding AcceptSelfSigned}"
                                  Margin="0,6,0,0" />
                        <TextBlock Text="{Binding CertificateStatus}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource BrushDim}" Margin="0,6,0,0" />
                        <Button x:Name="BtnVerifyCertificate" ic:IconAssist.Icon="{StaticResource IconShield}"
                                Content="{loc:Tr ProfileDialog_08}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                IsEnabled="{Binding AcceptSelfSigned}" Click="OnVerifyCertificate" />
                    </StackPanel>
                </ic:FormRow>

                <TextBlock Text="{loc:Tr ProfileDialog_09}" Style="{StaticResource FormSection}" />
                <ic:FormRow Label="{loc:Tr ProfileDialog_10}">
                    <WrapPanel>
                        <RadioButton Content="{loc:Tr ProfileDialog_11}"
                                     IsChecked="{Binding ProxyMode, Converter={StaticResource EnumToBool}, ConverterParameter=None}" />
                        <RadioButton Content="{loc:Tr ProfileDialog_12}"
                                     IsChecked="{Binding ProxyMode, Converter={StaticResource EnumToBool}, ConverterParameter=System}" />
                        <RadioButton Content="HTTP"
                                     IsChecked="{Binding ProxyMode, Converter={StaticResource EnumToBool}, ConverterParameter=Http}" />
                        <RadioButton Content="HTTPS"
                                     IsChecked="{Binding ProxyMode, Converter={StaticResource EnumToBool}, ConverterParameter=Https}" />
                        <RadioButton Content="SOCKS5"
                                     IsChecked="{Binding ProxyMode, Converter={StaticResource EnumToBool}, ConverterParameter=Socks5}" />
                    </WrapPanel>
                </ic:FormRow>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProxyMode}" Value="None">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProxyMode}" Value="System">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ic:FormRow Label="{loc:Tr ProfileDialog_13}">
                        <TextBox Text="{Binding ProxyHost, UpdateSourceTrigger=PropertyChanged}" />
                    </ic:FormRow>
                    <ic:FormRow Label="{loc:Tr ProfileDialog_14}">
                        <TextBox Text="{Binding ProxyPortText, UpdateSourceTrigger=PropertyChanged}"
                                 ic:InputFilter.Mode="Integer"
                                 Width="140" HorizontalAlignment="Left" />
                    </ic:FormRow>
                    <ic:FormRow Label="{loc:Tr ProfileDialog_15}" Hint="{loc:Tr ProfileDialog_16}">
                        <TextBox Text="{Binding ProxyUserName, UpdateSourceTrigger=PropertyChanged}" />
                    </ic:FormRow>
                    <ic:FormRow Label="{loc:Tr ProfileDialog_17}">
                        <PasswordBox x:Name="ProxyPasswordBox" />
                    </ic:FormRow>
                </StackPanel>

                <TextBlock Text="VPN (OpenVPN)" Style="{StaticResource FormSection}" />
                <ic:FormRow Label="{loc:Tr ProfileDialog_18}">
                    <CheckBox Content="{loc:Tr ProfileDialog_19}" IsChecked="{Binding UseVpn}" Margin="0,6,0,0" />
                </ic:FormRow>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UseVpn}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ic:FormRow Label="{loc:Tr ProfileDialog_20}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" ic:IconAssist.Icon="{StaticResource IconFolder}"
                                    Content="{loc:Tr ProfileDialog_21}"
                                    Click="OnBrowseVpnConfig" Margin="6,0,0,0" />
                            <TextBox Text="{Binding VpnConfigPath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </ic:FormRow>
                    <ic:FormRow Label="openvpn.exe" Hint="{Binding DetectedVpnExe}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" ic:IconAssist.Icon="{StaticResource IconFolder}"
                                    Content="{loc:Tr ProfileDialog_21}"
                                    Click="OnBrowseVpnExe" Margin="6,0,0,0" />
                            <TextBox Text="{Binding VpnExePath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </ic:FormRow>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button ic:IconAssist.Icon="{StaticResource IconSave}" Content="{loc:Tr AppSettingsWindow_12}"
                            Style="{StaticResource DialogPrimaryButton}" Click="OnSave" />
                    <Button ic:IconAssist.Icon="{StaticResource IconX}" Content="{loc:Tr AppSettingsWindow_13}"
                            Style="{StaticResource DialogButton}" IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource DialogStatus}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>