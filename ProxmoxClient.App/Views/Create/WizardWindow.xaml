<Window x:Class="ProxmoxClient.App.Views.Create.WizardWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
        xmlns:ic="clr-namespace:ProxmoxClient.App.Controls"
        Style="{StaticResource ThemedWindow}"
        Width="860" Height="640" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="OnClosing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 웹 UI 마법사의 단계 탭 — 지나온 단계만 눌러 돌아갈 수 있다 -->
        <ListBox x:Name="StepList" Grid.Row="0" Grid.Column="0" Margin="12,16,0,12"
                 SelectionChanged="OnStepClicked" />

        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PagePanel" Margin="20,16,20,12" />
        </ScrollViewer>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource DialogFooter}">
            <DockPanel LastChildFill="True">
                <CheckBox x:Name="AdvancedCheck" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0"
                          Content="{loc:Tr FormDialog_Advanced}" Checked="OnAdvancedChanged"
                          Unchecked="OnAdvancedChanged" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnBack" Content="{loc:Tr Wizard_Back}" Style="{StaticResource DialogButton}"
                            Click="OnBack" />
                    <Button x:Name="BtnNext" Content="{loc:Tr Wizard_Next}" Style="{StaticResource DialogPrimaryButton}"
                            Click="OnNext" IsDefault="True" />
                    <Button x:Name="BtnFinish" ic:IconAssist.Icon="{StaticResource IconPlus}"
                            Content="{loc:Tr Wizard_Finish}" Style="{StaticResource DialogPrimaryButton}"
                            Click="OnFinish" Visibility="Collapsed" />
                    <Button x:Name="BtnCancel" ic:IconAssist.Icon="{StaticResource IconX}" Content="{loc:Tr AppSettingsWindow_13}"
                            Style="{StaticResource DialogButton}" IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource DialogStatus}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
