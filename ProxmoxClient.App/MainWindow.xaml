<Window x:Class="ProxmoxClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ProxmoxClient.App.Localization"
        xmlns:ic="clr-namespace:ProxmoxClient.App.Controls"
        xmlns:c="clr-namespace:ProxmoxClient.App"
        xmlns:controls="clr-namespace:ProxmoxClient.App.Controls"
        Style="{StaticResource ThemedWindow}"
        Title="{loc:Tr App_Title}"
        Width="1280" Height="800" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <c:BytesHumanConverter x:Key="BytesFmt" />
        <c:UptimeConverter x:Key="UptimeFmt" />
        <c:DateTimeLocalConverter x:Key="DateLocal" />
        <c:KindLabelConverter x:Key="KindLabel" />
        <c:StatusToBrushConverter x:Key="StatusBrush" />
        <c:TagToBrushConverter x:Key="TagBrush" />
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 도구 모음 -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="14,9">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button ic:IconAssist.Icon="{StaticResource IconSwitch}" Content="{loc:Tr MainWindow_01}"
                            Click="OnSwitchServer"
                            Style="{StaticResource AccentButton}" MinWidth="100" Margin="0,0,8,0" />
                    <Button ic:IconAssist.Icon="{StaticResource IconLogOut}" Content="{loc:Tr MainWindow_02}"
                            Command="{Binding DisconnectCommand}" MinWidth="96" Margin="0,0,8,0" />
                    <Button ic:IconAssist.Icon="{StaticResource IconRefresh}" Content="{loc:Tr MainWindow_03}"
                            Command="{Binding RefreshCommand}" MinWidth="90" Margin="0,0,12,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" ic:IconAssist.Icon="{StaticResource IconSettings}"
                        Content="{loc:Tr MainWindow_04}"
                        Click="OnOpenAppSettings" Margin="12,0,0,0" ToolTip="{loc:Tr MainWindow_05}" />
                <CheckBox Content="{loc:Tr MainWindow_06}" IsChecked="{Binding AutoRefresh}" VerticalAlignment="Center"
                          DockPanel.Dock="Right" />
                <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" Margin="0,0,16,0"
                           DockPanel.Dock="Right" />
                <TextBlock Text="{Binding ServerInfo}" Foreground="{StaticResource BrushDim}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- 내용 영역 -->
        <Grid Grid.Row="1" Margin="14,10,14,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 내비게이션 -->
            <ListBox Grid.Row="0" x:Name="NavBox" SelectedIndex="{Binding NavIndex, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Margin="0,0,0,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem MinWidth="110">
                    <ic:IconLabel Icon="{StaticResource IconMonitor}" Text="{loc:Tr Tab_Guests}" />
                </ListBoxItem>
                <ListBoxItem MinWidth="100">
                    <ic:IconLabel Icon="{StaticResource IconServer}" Text="{loc:Tr Tab_Nodes}" />
                </ListBoxItem>
                <ListBoxItem MinWidth="100">
                    <ic:IconLabel Icon="{StaticResource IconDatabase}" Text="{loc:Tr MainWindow_07}" />
                </ListBoxItem>
                <ListBoxItem MinWidth="100">
                    <ic:IconLabel Icon="{StaticResource IconList}" Text="{loc:Tr Tab_Tasks}" />
                </ListBoxItem>
            </ListBox>

            <!-- 연결 전 안내 -->
            <Border Grid.Row="1" Background="{StaticResource BrushPanel}" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource BrushDim}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 패널 컨테이너 -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- 패널 0: 게스트 — 위: 선택 게스트 상세(정보 | 그래프, 동작 버튼) / 아래: 게스트 목록 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NavIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="160" />
                    </Grid.RowDefinitions>

                    <!-- ===== 선택 게스트 상세 ===== -->
                    <Border Grid.Row="0" Style="{StaticResource FormPanel}" Padding="0" Margin="0,0,0,10">
                        <Grid>
                            <!-- 선택 없음 안내 -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedGuest}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ic:PathIcon Data="{StaticResource IconMonitor}" Width="28" Height="28"
                                             IconBrush="{StaticResource BrushDim}" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Tr MainWindow_08}"
                                           Foreground="{StaticResource BrushDim}" Margin="0,8,0,0" />
                            </StackPanel>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedGuest}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 헤더: 게스트 식별 + 동작 -->
                                <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="0,0,0,1" Padding="14,10">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding Permissions.CanPowerMgmt, Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
                                                <Button ic:IconAssist.Icon="{StaticResource IconPlay}"
                                                        ic:IconAssist.Brush="{StaticResource BrushOk}"
                                                        Content="{loc:Tr MainWindow_33}"
                                                        Command="{Binding StartGuestCommand}" Margin="0,0,6,0"
                                                        ic:GuestPowerVisibility.Action="Start"
                                                        ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}" />
                                                <Button ic:IconAssist.Icon="{StaticResource IconPower}"
                                                        ic:IconAssist.Brush="{StaticResource BrushWarn}"
                                                        Content="{loc:Tr MainWindow_35}"
                                                        Command="{Binding ShutdownGuestCommand}" Margin="0,0,6,0"
                                                        ic:GuestPowerVisibility.Action="Shutdown"
                                                        ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}" />
                                                <Button ic:IconAssist.Icon="{StaticResource IconSquare}"
                                                        ic:IconAssist.Brush="{StaticResource BrushErr}"
                                                        Content="{loc:Tr MainWindow_36}"
                                                        Command="{Binding StopGuestCommand}" Margin="0,0,6,0"
                                                        ic:GuestPowerVisibility.Action="Stop"
                                                        ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}" />
                                                <Button ic:IconAssist.Icon="{StaticResource IconRotate}"
                                                        Content="{loc:Tr MainWindow_34}"
                                                        Command="{Binding RebootGuestCommand}" Margin="0,0,6,0"
                                                        ic:GuestPowerVisibility.Action="Reboot"
                                                        ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}" />
                                                <Border Width="1" Background="{StaticResource BrushBorder}"
                                                        Margin="4,4,10,4" />
                                            </StackPanel>
                                            <Button ic:IconAssist.Icon="{StaticResource IconMonitor}"
                                                    Content="{loc:Tr MainWindow_09}" Click="OnOpenConsole"
                                                    Style="{StaticResource AccentButton}" Margin="0,0,6,0"
                                                    Visibility="{Binding Permissions.CanConsole, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                                            <Button ic:IconAssist.Icon="{StaticResource IconCamera}"
                                                    Content="{loc:Tr MainWindow_Snapshots}"
                                                    Click="OnOpenSnapshot" Margin="0,0,6,0"
                                                    Visibility="{Binding Permissions.CanSnapshot, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                                            <Button ic:IconAssist.Icon="{StaticResource IconSettings}"
                                                    Content="{loc:Tr MainWindow_04}" Click="OnMenuSettings"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding Permissions.CanConfigure, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                                            <Button ic:IconAssist.Icon="{StaticResource IconMore}"
                                                    ToolTip="{loc:Tr MainWindow_10}" Padding="9,6"
                                                    Click="OnMoreActions">
                                                <Button.ContextMenu>
                                                    <ContextMenu
                                                        DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem ic:IconAssist.Icon="{StaticResource IconPause}"
                                                                  Header="{loc:Tr MainWindow_11}"
                                                                  Command="{Binding SuspendGuestCommand}"
                                                                  ic:GuestPowerVisibility.Action="Suspend"
                                                                  ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}"
                                                                  ic:GuestPowerVisibility.Allowed="{Binding Permissions.CanPowerMgmt, FallbackValue=True}" />
                                                        <MenuItem ic:IconAssist.Icon="{StaticResource IconResume}"
                                                                  Header="{loc:Tr MainWindow_12}"
                                                                  Command="{Binding ResumeGuestCommand}"
                                                                  ic:GuestPowerVisibility.Action="Resume"
                                                                  ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}"
                                                                  ic:GuestPowerVisibility.Allowed="{Binding Permissions.CanPowerMgmt, FallbackValue=True}" />
                                                        <MenuItem ic:IconAssist.Icon="{StaticResource IconMoon}"
                                                                  Header="{loc:Tr MainWindow_13}"
                                                                  Command="{Binding HibernateGuestCommand}"
                                                                  ic:GuestPowerVisibility.Action="Hibernate"
                                                                  ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}"
                                                                  ic:GuestPowerVisibility.Allowed="{Binding Permissions.CanPowerMgmt, FallbackValue=True}" />
                                                        <Separator />
                                                        <MenuItem ic:IconAssist.Icon="{StaticResource IconCopy}"
                                                                  Header="{loc:Tr MainWindow_14}" Click="OnMenuClone"
                                                                  Visibility="{Binding Permissions.CanClone, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                                                        <MenuItem ic:IconAssist.Icon="{StaticResource IconArchive}"
                                                                  Header="{loc:Tr MainWindow_15}" Click="OnMenuBackup"
                                                                  Visibility="{Binding Permissions.CanBackup, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                                                        <MenuItem ic:IconAssist.Icon="{StaticResource IconShield}"
                                                                  Header="{loc:Tr MainWindow_16}"
                                                                  Click="OnMenuFirewall"
                                                                  Visibility="{Binding Permissions.CanConfigure, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ic:PathIcon Width="22" Height="22" Margin="0,0,10,0">
                                                <ic:PathIcon.Style>
                                                    <Style TargetType="ic:PathIcon">
                                                        <Setter Property="Data" Value="{StaticResource IconMonitor}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGuest.Kind}"
                                                                         Value="Lxc">
                                                                <Setter Property="Data"
                                                                        Value="{StaticResource IconBox}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ic:PathIcon.Style>
                                            </ic:PathIcon>
                                            <StackPanel>
                                                <TextBlock FontSize="15" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding SelectedGuest.Name, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Foreground="{StaticResource BrushDim}" FontSize="11"
                                                           Margin="0,1,0,0">
                                                    <Run
                                                        Text="{Binding SelectedGuest.Kind, Mode=OneWay, Converter={StaticResource KindLabel}}" />
                                                    <Run Text="{Binding SelectedGuest.VmId, Mode=OneWay}" />
                                                    <Run Text="{loc:Tr MainWindow_17}" />
                                                    <Run Text="{Binding SelectedGuest.Node, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Background="{StaticResource BrushControl}" CornerRadius="10"
                                                    Padding="9,3" Margin="14,0,0,0"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{Binding SelectedGuest.Status, Mode=OneWay, Converter={StaticResource StatusBrush}}" />
                                                    <TextBlock Text="{Binding SelectedGuest.Status, Mode=OneWay}"
                                                               FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- 본문: 정보 | 그래프 -->
                                <Grid Grid.Row="1" Margin="14,10,14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Margin="0,0,20,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 사용량은 노드 화면과 같은 형식 — 값을 막대 위에 겹쳐 이름과 같은 줄에 둔다 -->
                                        <TextBlock Grid.Row="0" Text="CPU" Foreground="{StaticResource BrushDim}"
                                                   VerticalAlignment="Center" Margin="0,0,0,6" />
                                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                            <ProgressBar Height="18" Minimum="0" Maximum="100"
                                                         Value="{Binding SelectedGuest.CpuUsagePercent, Mode=OneWay}" />
                                            <TextBlock FontSize="11" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <Run
                                                    Text="{Binding SelectedGuest.CpuUsagePercent, Mode=OneWay, StringFormat={}{0:F1}%}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding SelectedGuest.CpuCount, Mode=OneWay}" />
                                                <Run Text="{loc:Tr MainWindow_18}" />
                                            </TextBlock>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{loc:Tr MainWindow_19}"
                                                   Foreground="{StaticResource BrushDim}"
                                                   VerticalAlignment="Center" Margin="0,0,0,6" />
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                                            <ProgressBar Height="18" Minimum="0"
                                                         Maximum="{Binding SelectedGuest.MaxMemBytes, Mode=OneWay}"
                                                         Value="{Binding SelectedGuest.MemBytes, Mode=OneWay}" />
                                            <TextBlock FontSize="11" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <Run
                                                    Text="{Binding SelectedGuest.MemBytes, Mode=OneWay, Converter={StaticResource BytesFmt}}" />
                                                <Run Text=" / " />
                                                <Run
                                                    Text="{Binding SelectedGuest.MaxMemBytes, Mode=OneWay, Converter={StaticResource BytesFmt}}" />
                                            </TextBlock>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Text="{loc:Tr MainWindow_20}"
                                                   Foreground="{StaticResource BrushDim}"
                                                   VerticalAlignment="Center" Margin="0,0,0,6" />
                                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                                            <ProgressBar Height="18" Minimum="0"
                                                         Maximum="{Binding SelectedGuest.MaxDiskBytes, Mode=OneWay}"
                                                         Value="{Binding SelectedGuest.DiskBytes, Mode=OneWay}" />
                                            <TextBlock FontSize="11" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <Run
                                                    Text="{Binding SelectedGuest.DiskBytes, Mode=OneWay, Converter={StaticResource BytesFmt}}" />
                                                <Run Text=" / " />
                                                <Run
                                                    Text="{Binding SelectedGuest.MaxDiskBytes, Mode=OneWay, Converter={StaticResource BytesFmt}}" />
                                            </TextBlock>
                                        </Grid>

                                        <TextBlock Grid.Row="3" Text="{loc:Tr MainWindow_21}"
                                                   Foreground="{StaticResource BrushDim}" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Margin="0,0,0,8"
                                                   Text="{Binding SelectedGuest.UptimeDisplaySeconds, Mode=OneWay, Converter={StaticResource UptimeFmt}}" />

                                        <TextBlock Grid.Row="4" Text="{loc:Tr MainWindow_22}"
                                                   Foreground="{StaticResource BrushDim}" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12" Margin="0,0,0,8"
                                                   Text="{Binding SelectedGuest.Pool, Mode=OneWay, TargetNullValue='—'}" />

                                        <TextBlock Grid.Row="5" Text="{loc:Tr MainWindow_23}"
                                                   Foreground="{StaticResource BrushDim}" />
                                        <ItemsControl Grid.Row="5" Grid.Column="1"
                                                      ItemsSource="{Binding SelectedGuest.Tags, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding Converter={StaticResource TagBrush}}"
                                                            CornerRadius="7" Padding="7,1" Margin="0,0,4,4">
                                                        <TextBlock Text="{Binding Mode=OneWay}" FontSize="11"
                                                                   Foreground="White" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                            <ListBox DockPanel.Dock="Right" x:Name="GuestTfBox"
                                                     SelectionChanged="OnGuestTfChanged"
                                                     Background="Transparent" BorderThickness="0" SelectedIndex="0">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBoxItem Content="{loc:Tr MainWindow_24}" Tag="hour" />
                                                <ListBoxItem Content="{loc:Tr MainWindow_25}" Tag="day" />
                                                <ListBoxItem Content="{loc:Tr MainWindow_26}" Tag="week" />
                                                <ListBoxItem Content="{loc:Tr MainWindow_27}" Tag="month" />
                                                <ListBoxItem Content="{loc:Tr MainWindow_28}" Tag="year" />
                                            </ListBox>
                                            <TextBlock Text="{loc:Tr MainWindow_29}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource BrushDim}" />
                                        </DockPanel>
                                        <Grid Grid.Row="1" Height="190">
                                            <controls:GraphLine Series="{Binding GuestGraphSeries}"
                                                                XLabels="{Binding GuestGraphXLabels}"
                                                                Timestamps="{Binding GuestGraphTimes}">
                                                <controls:GraphLine.Style>
                                                    <Style TargetType="controls:GraphLine">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GuestGraphSeries}"
                                                                         Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:GraphLine.Style>
                                            </controls:GraphLine>
                                            <Image Source="{Binding GuestGraph}" Stretch="Fill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GuestGraph}"
                                                                         Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ===== 게스트 목록 ===== -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" ic:IconAssist.Icon="{StaticResource IconPlus}"
                                    Content="{loc:Tr MainWindow_30}"
                                    Click="OnCreateGuest" Style="{StaticResource AccentButton}"
                                    Visibility="{Binding Permissions.CanAllocate, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{loc:Tr MainWindow_31}" FontWeight="SemiBold" />
                                <Run Text="  " />
                                <Run Text="{Binding Guests.Count, Mode=OneWay, FallbackValue=0}"
                                     Foreground="{StaticResource BrushDim}" />
                                <Run Text="{loc:Tr MainWindow_32}" Foreground="{StaticResource BrushDim}" />
                            </TextBlock>
                        </DockPanel>

                        <DataGrid Grid.Row="1" x:Name="GuestGrid" ItemsSource="{Binding Guests}"
                                  SelectedItem="{Binding SelectedGuest}"
                                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  PreviewMouseRightButtonDown="OnGuestGridRightClick"
                                  MouseDoubleClick="OnGuestGridDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu
                                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconMonitor}"
                                              Header="{loc:Tr MainWindow_09}" Click="OnMenuConsole"
                                              Visibility="{Binding Permissions.CanConsole, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                                    <Separator />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconPlay}"
                                              ic:IconAssist.Brush="{StaticResource BrushOk}"
                                              Header="{loc:Tr MainWindow_33}" Command="{Binding StartGuestCommand}"
                                              ic:GuestPowerVisibility.Action="Start"
                                              ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}"
                                              ic:GuestPowerVisibility.Allowed="{Binding Permissions.CanPowerMgmt, FallbackValue=True}" />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconPause}"
                                              Header="{loc:Tr MainWindow_11}" Command="{Binding SuspendGuestCommand}"
                                              ic:GuestPowerVisibility.Action="Suspend"
                                              ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}"
                                              ic:GuestPowerVisibility.Allowed="{Binding Permissions.CanPowerMgmt, FallbackValue=True}" />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconResume}"
                                              Header="{loc:Tr MainWindow_12}" Command="{Binding ResumeGuestCommand}"
                                              ic:GuestPowerVisibility.Action="Resume"
                                              ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}"
                                              ic:GuestPowerVisibility.Allowed="{Binding Permissions.CanPowerMgmt, FallbackValue=True}" />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconMoon}"
                                              Header="{loc:Tr MainWindow_13}" Command="{Binding HibernateGuestCommand}"
                                              ic:GuestPowerVisibility.Action="Hibernate"
                                              ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}"
                                              ic:GuestPowerVisibility.Allowed="{Binding Permissions.CanPowerMgmt, FallbackValue=True}" />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconRotate}"
                                              Header="{loc:Tr MainWindow_34}" Command="{Binding RebootGuestCommand}"
                                              ic:GuestPowerVisibility.Action="Reboot"
                                              ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}"
                                              ic:GuestPowerVisibility.Allowed="{Binding Permissions.CanPowerMgmt, FallbackValue=True}" />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconPower}"
                                              ic:IconAssist.Brush="{StaticResource BrushWarn}"
                                              Header="{loc:Tr MainWindow_35}" Command="{Binding ShutdownGuestCommand}"
                                              ic:GuestPowerVisibility.Action="Shutdown"
                                              ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}"
                                              ic:GuestPowerVisibility.Allowed="{Binding Permissions.CanPowerMgmt, FallbackValue=True}" />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconSquare}"
                                              ic:IconAssist.Brush="{StaticResource BrushErr}"
                                              Header="{loc:Tr MainWindow_36}" Command="{Binding StopGuestCommand}"
                                              ic:GuestPowerVisibility.Action="Stop"
                                              ic:GuestPowerVisibility.Guest="{Binding SelectedGuest}"
                                              ic:GuestPowerVisibility.Allowed="{Binding Permissions.CanPowerMgmt, FallbackValue=True}" />
                                    <Separator />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconCamera}"
                                              Header="{loc:Tr MainWindow_37}" Click="OnMenuSnapshot"
                                              Visibility="{Binding Permissions.CanSnapshot, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconCopy}"
                                              Header="{loc:Tr MainWindow_14}" Click="OnMenuClone"
                                              Visibility="{Binding Permissions.CanClone, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconArchive}"
                                              Header="{loc:Tr MainWindow_15}" Click="OnMenuBackup"
                                              Visibility="{Binding Permissions.CanBackup, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                                    <Separator />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconShield}"
                                              Header="{loc:Tr MainWindow_16}" Click="OnMenuFirewall"
                                              Visibility="{Binding Permissions.CanConfigure, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                                    <MenuItem ic:IconAssist.Icon="{StaticResource IconSettings}"
                                              Header="{loc:Tr MainWindow_38}" Click="OnMenuSettings"
                                              Visibility="{Binding Permissions.CanConfigure, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:Tr MainWindow_39}" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ic:PathIcon Width="14" Height="14" Margin="0,0,6,0">
                                                    <ic:PathIcon.Style>
                                                        <Style TargetType="ic:PathIcon">
                                                            <Setter Property="Data"
                                                                    Value="{StaticResource IconMonitor}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Lxc">
                                                                    <Setter Property="Data"
                                                                            Value="{StaticResource IconBox}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ic:PathIcon.Style>
                                                </ic:PathIcon>
                                                <TextBlock
                                                    Text="{Binding Kind, Mode=OneWay, Converter={StaticResource KindLabel}}"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="VMID" Binding="{Binding VmId, Mode=OneWay}" Width="70" />
                                <DataGridTemplateColumn Header="{loc:Tr MainWindow_40}" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- 태그는 이름 옆에 한 줄로 — 행 높이(30) 안에서 잘리지 않도록 -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                           VerticalAlignment="Center" />
                                                <ItemsControl ItemsSource="{Binding Tags, Mode=OneWay}"
                                                              Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Background="{Binding Converter={StaticResource TagBrush}}"
                                                                CornerRadius="7" Padding="7,0" Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding Mode=OneWay}" FontSize="10"
                                                                           Foreground="White" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr MainWindow_41}"
                                                    Binding="{Binding Node, Mode=OneWay}" Width="100" />
                                <DataGridTemplateColumn Header="{loc:Tr MainWindow_42}" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9" Height="9" Margin="2,2,6,2"
                                                         Fill="{Binding Status, Mode=OneWay, Converter={StaticResource StatusBrush}}" />
                                                <TextBlock Text="{Binding Status, Mode=OneWay}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="CPU" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" Margin="0,2">
                                                <ProgressBar Minimum="0" Maximum="100"
                                                             Value="{Binding CpuUsagePercent, Mode=OneWay}" Height="12" />
                                                <TextBlock
                                                    Text="{Binding CpuUsagePercent, Mode=OneWay, StringFormat={}{0:F1}%}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    FontSize="11" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr MainWindow_19}" Width="100"
                                                    Binding="{Binding MemBytes, Mode=OneWay, Converter={StaticResource BytesFmt}}" />
                                <DataGridTextColumn Header="{loc:Tr MainWindow_20}" Width="100"
                                                    Binding="{Binding DiskBytes, Mode=OneWay, Converter={StaticResource BytesFmt}}" />
                                <DataGridTextColumn Header="{loc:Tr MainWindow_21}" Width="*" MinWidth="120"
                                                    Binding="{Binding UptimeDisplaySeconds, Mode=OneWay, Converter={StaticResource UptimeFmt}}" />
                                <DataGridCheckBoxColumn Header="{loc:Tr MainWindow_43}"
                                                        Binding="{Binding IsTemplate, Mode=OneWay}" Width="70">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                            <Setter Property="Focusable" Value="False" />
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <!-- 패널 1: 노드 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NavIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BrushPanel}" CornerRadius="6" Padding="10"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr MainWindow_NodeList}"
                                       Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                            <ListBox ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,5">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9" Height="9" Margin="2,2,6,2"
                                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                <TextBlock Text="{Binding Node}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Foreground="{StaticResource BrushDim}" FontSize="11"
                                                       Margin="17,2,0,0">
                                                <Run Text="CPU " />
                                                <Run Text="{Binding CpuUsagePercent, StringFormat={}{0:F0}%}" />
                                                <Run Text="{loc:Tr MainWindow_44}" /><Run Text="{Binding CpuCount}" />
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource BrushDim}" FontSize="11"
                                                       Margin="17,0,0,0">
                                                <Run Text="{loc:Tr MainWindow_45}" />
                                                <Run Text="{Binding MemBytes, Converter={StaticResource BytesFmt}}" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding MaxMemBytes, Converter={StaticResource BytesFmt}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:Tr MainWindow_NodeDetail}" Style="{StaticResource SectionHeader}"
                                       Margin="2,0,0,8" />
                            <Border Background="{StaticResource BrushPanel}" CornerRadius="6" Padding="12"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr MainWindow_46}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding NodeStatus.KernelVersion, TargetNullValue='—'}"
                                               Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr MainWindow_47}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding NodeStatus.CpuCores, TargetNullValue='—'}"
                                               Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr MainWindow_48}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                                        <Run
                                            Text="{Binding NodeStatus.LoadAverage1, Mode=OneWay, StringFormat={}{0:F2}, FallbackValue='—'}" />
                                        <Run Text=" / " Foreground="{StaticResource BrushDim}" />
                                        <Run
                                            Text="{Binding NodeStatus.LoadAverage5, Mode=OneWay, StringFormat={}{0:F2}, FallbackValue='—'}" />
                                        <Run Text=" / " Foreground="{StaticResource BrushDim}" />
                                        <Run
                                            Text="{Binding NodeStatus.LoadAverage15, Mode=OneWay, StringFormat={}{0:F2}, FallbackValue='—'}" />
                                        <Run Text="{loc:Tr MainWindow_49}" Foreground="{StaticResource BrushDim}"
                                             FontSize="11" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr MainWindow_21}"
                                               Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{Binding NodeStatus.UptimeSeconds, Converter={StaticResource UptimeFmt}, TargetNullValue='—'}"
                                               Margin="0,0,0,6" />
                                    <!-- 사용량은 막대 위에 값을 겹쳐 한 줄로 — 이름과 막대가 같은 줄에 놓여 어느 항목인지 헷갈리지 않는다 -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr MainWindow_19}"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,6" />
                                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,6">
                                        <ProgressBar Height="18" Minimum="0"
                                                     Maximum="{Binding NodeStatus.MemTotalBytes, TargetNullValue=1}"
                                                     Value="{Binding NodeStatus.MemUsedBytes, TargetNullValue=0}" />
                                        <TextBlock FontSize="11" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <Run
                                                Text="{Binding NodeStatus.MemUsedBytes, Mode=OneWay, Converter={StaticResource BytesFmt}, TargetNullValue='—'}" />
                                            <Run Text=" / " />
                                            <Run
                                                Text="{Binding NodeStatus.MemTotalBytes, Mode=OneWay, Converter={StaticResource BytesFmt}, TargetNullValue='—'}" />
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Tr MainWindow_50}"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,6" />
                                    <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,6">
                                        <ProgressBar Height="18" Minimum="0"
                                                     Maximum="{Binding NodeStatus.SwapTotalBytes, TargetNullValue=1}"
                                                     Value="{Binding NodeStatus.SwapUsedBytes, TargetNullValue=0}" />
                                        <TextBlock FontSize="11" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <Run
                                                Text="{Binding NodeStatus.SwapUsedBytes, Mode=OneWay, Converter={StaticResource BytesFmt}, TargetNullValue='—'}" />
                                            <Run Text=" / " />
                                            <Run
                                                Text="{Binding NodeStatus.SwapTotalBytes, Mode=OneWay, Converter={StaticResource BytesFmt}, TargetNullValue='—'}" />
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Tr MainWindow_51}"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,6" />
                                    <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,6">
                                        <ProgressBar Height="18" Minimum="0"
                                                     Maximum="{Binding NodeStatus.RootFsTotalBytes, TargetNullValue=1}"
                                                     Value="{Binding NodeStatus.RootFsUsedBytes, TargetNullValue=0}" />
                                        <TextBlock FontSize="11" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <Run
                                                Text="{Binding NodeStatus.RootFsUsedBytes, Mode=OneWay, Converter={StaticResource BytesFmt}, TargetNullValue='—'}" />
                                            <Run Text=" / " />
                                            <Run
                                                Text="{Binding NodeStatus.RootFsTotalBytes, Mode=OneWay, Converter={StaticResource BytesFmt}, TargetNullValue='—'}" />
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Text="{loc:Tr MainWindow_52}" Style="{StaticResource SectionHeader}"
                                       Margin="2,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{loc:Tr MainWindow_53}" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushDim}" Margin="0,0,4,0" />
                                <ListBox x:Name="NodeTfBox" SelectionChanged="OnNodeTfChanged" Background="Transparent"
                                         BorderThickness="0" SelectedIndex="0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBoxItem Content="{loc:Tr MainWindow_24}" Tag="hour" />
                                    <ListBoxItem Content="{loc:Tr MainWindow_25}" Tag="day" />
                                    <ListBoxItem Content="{loc:Tr MainWindow_26}" Tag="week" />
                                    <ListBoxItem Content="{loc:Tr MainWindow_27}" Tag="month" />
                                    <ListBoxItem Content="{loc:Tr MainWindow_28}" Tag="year" />
                                </ListBox>
                            </StackPanel>
                            <Grid Height="190">
                                <controls:GraphLine Series="{Binding NodeGraphSeries}"
                                                    XLabels="{Binding NodeGraphXLabels}"
                                                    Timestamps="{Binding NodeGraphTimes}">
                                    <controls:GraphLine.Style>
                                        <Style TargetType="controls:GraphLine">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NodeGraphSeries}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:GraphLine.Style>
                                </controls:GraphLine>
                                <Image Source="{Binding NodeGraph}" Stretch="Fill">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NodeGraph}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 패널 2: 스토리지 -->
                <DataGrid ItemsSource="{Binding Storages}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NavIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Tr MainWindow_40}" Binding="{Binding Storage, Mode=OneWay}"
                                            Width="160" />
                        <DataGridTextColumn Header="{loc:Tr MainWindow_41}" Binding="{Binding Node, Mode=OneWay}"
                                            Width="110" />
                        <DataGridTextColumn Header="{loc:Tr MainWindow_54}" Binding="{Binding PluginType, Mode=OneWay}"
                                            Width="110" />
                        <DataGridTextColumn Header="{loc:Tr MainWindow_55}" Binding="{Binding Content, Mode=OneWay}"
                                            Width="200" />
                        <DataGridTemplateColumn Header="{loc:Tr MainWindow_56}" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center" Margin="0,2">
                                        <ProgressBar Minimum="0" Maximum="100"
                                                     Value="{Binding UsagePercent, Mode=OneWay}" Height="12" />
                                        <TextBlock Text="{Binding UsagePercent, Mode=OneWay, StringFormat={}{0:F1}%}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Tr MainWindow_57}" Width="100"
                                            Binding="{Binding DiskBytes, Mode=OneWay, Converter={StaticResource BytesFmt}}" />
                        <DataGridTextColumn Header="{loc:Tr MainWindow_58}" Width="100"
                                            Binding="{Binding MaxDiskBytes, Mode=OneWay, Converter={StaticResource BytesFmt}}" />
                        <DataGridTemplateColumn Header="{loc:Tr MainWindow_42}" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Margin="2,2,6,2"
                                                 Fill="{Binding Status, Mode=OneWay, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{Binding StatusDisplay, Mode=OneWay}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 패널 3: 작업 -->
                <DataGrid ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NavIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Tr MainWindow_TaskStart}"
                                            Binding="{Binding StartTimeUtc, Mode=OneWay, Converter={StaticResource DateLocal}}"
                                            Width="150" />
                        <DataGridTextColumn Header="{loc:Tr MainWindow_TaskEnd}"
                                            Binding="{Binding EndTimeUtc, Mode=OneWay, Converter={StaticResource DateLocal}}"
                                            Width="150" />
                        <DataGridTextColumn Header="{loc:Tr MainWindow_41}" Binding="{Binding Node, Mode=OneWay}"
                                            Width="100" />
                        <DataGridTextColumn Header="{loc:Tr MainWindow_54}" Binding="{Binding Type, Mode=OneWay}"
                                            Width="130" />
                        <DataGridTextColumn Header="{loc:Tr MainWindow_59}" Binding="{Binding Id, Mode=OneWay}"
                                            Width="140" />
                        <DataGridTextColumn Header="{loc:Tr MainWindow_60}" Binding="{Binding User, Mode=OneWay}"
                                            Width="150" />
                        <DataGridTemplateColumn Header="{loc:Tr MainWindow_42}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status, Mode=OneWay}"
                                               Foreground="{Binding Status, Mode=OneWay, Converter={StaticResource StatusBrush}, ConverterParameter=task}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- 상태 표시줄 -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushDim}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Margin="0,0,16,0">
                    <Run Text="{loc:Tr MainWindow_61}" />
                    <Run Text="{Binding Guests.Count, Mode=OneWay, FallbackValue=0}" FontWeight="SemiBold" />
                    <Run Text="{loc:Tr MainWindow_62}" />
                    <Run Text="{Binding Nodes.Count, Mode=OneWay, FallbackValue=0}" FontWeight="SemiBold" />
                    <Run Text="{loc:Tr MainWindow_32}" />
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding ConnectionStatus}" Foreground="{StaticResource BrushDim}" />
            </Grid>
        </Border>
    </Grid>
</Window>