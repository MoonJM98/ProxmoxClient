<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\ProxmoxClient.Core\ProxmoxClient.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!--
            Windows Terminal WPF 컨트롤 — MIT 바이너리를 packages\ 에 직접 담아 쓴다.
            Microsoft 가 nuget.org 에 게시하지 않는 컨트롤이라(microsoft/terminal #6999) 공식 패키지가 없다.
        -->
        <PackageReference Include="ProxmoxClient.Vendored.Terminal.Wpf" Version="1.25.2603.3002"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
    </ItemGroup>

    <!-- 고지 의무 — 배포 폴더에 라이선스와 서드파티 고지 원문을 함께 둔다 -->
    <ItemGroup>
        <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="..\third-party\**" Link="third-party\%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <!-- 로그인 화면 로고 — 실행 파일·작업 표시줄·모든 창의 아이콘 -->
        <ApplicationIcon>app.ico</ApplicationIcon>
        <Product>Proxmox Client</Product>
        <Copyright>Copyright (c) 2026 ProxmoxClient Contributors</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

</Project>
