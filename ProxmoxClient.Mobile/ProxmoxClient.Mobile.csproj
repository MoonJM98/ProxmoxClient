<Project Sdk="Microsoft.NET.Sdk">

    <!--
        모바일(Android) 공용 UI — Avalonia 12. 서버 통신·모델은 데스크톱과 같은 ProxmoxClient.Core 를 그대로 쓴다.
        플랫폼별 기능(비밀값 보관 등)은 Services 의 인터페이스로 받고, 각 헤드 프로젝트가 구현을 넣는다.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <RootNamespace>ProxmoxClient.Mobile</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ProxmoxClient.Core\ProxmoxClient.Core.csproj" />
    </ItemGroup>

</Project>
