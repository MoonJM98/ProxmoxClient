<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProxmoxClient.Mobile.ViewModels"
             xmlns:c="using:ProxmoxClient.Mobile.Converters"
             xmlns:l="using:ProxmoxClient.Mobile.Localization"
             x:Class="ProxmoxClient.Mobile.Views.NodeDetailPage"
             x:DataType="vm:NodeDetailViewModel"
             Header="{Binding Title}">

    <NavigationPage.TopCommandBar>
        <Button Classes="icon" Command="{Binding ReloadCommand}">
            <Path Classes="icon" Data="{StaticResource IconRefresh}" />
        </Button>
    </NavigationPage.TopCommandBar>

    <ScrollViewer>
        <StackPanel Margin="16,12,16,32" Spacing="12">
            <Border Classes="banner" IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="dot" Fill="{Binding Node.Status, Converter={x:Static c:Conv.StatusBrush}}" />
                        <TextBlock Classes="headline" Text="{Binding Node.Node}" />
                    </StackPanel>
                    <TextBlock Classes="subtle" Text="{Binding CpuModel}" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock Classes="subtle" Text="{Binding Kernel}" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock Classes="subtle">
                        <Run Text="{l:Tr Node_Uptime}" />
                        <Run Text="{Binding UptimeText}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="CPU" />
                            <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding CpuText}" />
                        </Grid>
                        <ProgressBar Classes="usage" Value="{Binding CpuRatio}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{l:Tr Node_Load}" />
                        <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding LoadText}" />
                    </Grid>
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{l:Tr Common_Memory}" />
                            <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding MemText}" />
                        </Grid>
                        <ProgressBar Classes="usage" Value="{Binding MemRatio}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{l:Tr Node_Swap}" />
                            <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding SwapText}" />
                        </Grid>
                        <ProgressBar Classes="usage" Value="{Binding SwapRatio}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{l:Tr Node_RootFs}" />
                            <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding RootFsText}" />
                        </Grid>
                        <ProgressBar Classes="usage" Value="{Binding RootFsRatio}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Classes="section" Text="{l:Tr Node_Guests}" />
            <ItemsControl ItemsSource="{Binding Guests}" Tag="{Binding OpenGuestCommand}"
                          ItemTemplate="{StaticResource GuestRowTemplate}"
                          ItemsPanel="{StaticResource CardListPanel}" />
        </StackPanel>
    </ScrollViewer>
</ContentPage>
