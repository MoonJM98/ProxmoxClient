<TabbedPage xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:ProxmoxClient.Mobile.ViewModels"
            xmlns:m="using:ProxmoxClient.Core.Models"
            xmlns:c="using:ProxmoxClient.Mobile.Converters"
            xmlns:s="using:ProxmoxClient.Mobile.Services"
            xmlns:l="using:ProxmoxClient.Mobile.Localization"
            x:Class="ProxmoxClient.Mobile.Views.ClusterPage"
            x:DataType="vm:ClusterViewModel"
            Header="{Binding Title}"
            TabPlacement="Bottom">

    <NavigationPage.TopCommandBar>
        <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="icon" Command="{Binding RefreshCommand}">
                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
            </Button>
            <Button Classes="icon" Command="{Binding LogoutCommand}">
                <Path Classes="icon" Data="{StaticResource IconLogOut}" />
            </Button>
        </StackPanel>
    </NavigationPage.TopCommandBar>

    <!-- 게스트 -->
    <ContentPage Header="{l:Tr Cluster_TabGuests}">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <Border Classes="banner" Margin="16,10,16,0" IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Grid.Row="1" Margin="16,12,16,0" Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="subtle" Text="{Binding Subtitle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding GuestSummary}"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBox Text="{Binding SearchText}" PlaceholderText="{l:Tr Cluster_SearchHint}"
                         TextInputOptions.ContentType="Search">
                    <TextBox.InnerLeftContent>
                        <Path Classes="icon" Width="16" Height="16" Margin="10,0,0,0" Opacity="0.6"
                              Data="{StaticResource IconSearch}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,10,16,4">
                <RadioButton Classes="chip" GroupName="filter" IsChecked="{Binding FilterAll}"
                             Content="{l:Tr Cluster_FilterAll}" />
                <RadioButton Classes="chip" GroupName="filter" IsChecked="{Binding FilterRunning}"
                             Content="{l:Tr Cluster_FilterRunning}" />
                <RadioButton Classes="chip" GroupName="filter" IsChecked="{Binding FilterStopped}"
                             Content="{l:Tr Cluster_FilterStopped}" />
            </StackPanel>
            <RefreshContainer Grid.Row="3" RefreshRequested="OnRefreshRequested">
                <ScrollViewer>
                    <StackPanel Margin="16,8,16,24">
                        <ItemsControl ItemsSource="{Binding Guests}" Tag="{Binding OpenGuestCommand}"
                                      ItemTemplate="{StaticResource GuestRowTemplate}"
                                      ItemsPanel="{StaticResource CardListPanel}" />
                        <TextBlock Classes="subtle" Margin="0,40,0,0" HorizontalAlignment="Center"
                                   Text="{l:Tr Cluster_NoGuests}" IsVisible="{Binding IsGuestListEmpty}" />
                        <ProgressBar IsIndeterminate="True" Margin="40,40,40,0"
                                     IsVisible="{Binding !IsLoaded}" />
                    </StackPanel>
                </ScrollViewer>
            </RefreshContainer>
        </Grid>
    </ContentPage>

    <!-- 노드 -->
    <ContentPage Header="{l:Tr Cluster_TabNodes}">
        <RefreshContainer RefreshRequested="OnRefreshRequested">
            <ScrollViewer>
                <StackPanel Margin="16,12,16,24" Spacing="10">
                    <TextBlock Classes="subtle" Text="{Binding NodeSummary}" Margin="4,0" />
                    <ItemsControl ItemsSource="{Binding Nodes}" ItemsPanel="{StaticResource CardListPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:PveNode">
                                <Border Classes="card" Padding="0">
                                    <Button Classes="row"
                                            Command="{Binding $parent[ItemsControl].((vm:ClusterViewModel)DataContext).OpenNodeCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Ellipse Classes="dot" Margin="0,0,12,0"
                                                         Fill="{Binding Status, Converter={x:Static c:Conv.StatusBrush}}" />
                                                <TextBlock Grid.Column="1" Classes="title" Text="{Binding Node}" />
                                                <TextBlock Grid.Column="2" Classes="subtle"
                                                           Text="{Binding UptimeSeconds, Converter={x:Static c:Conv.Uptime}}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,16,*" IsVisible="{Binding IsOnline}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="subtle" FontSize="11">
                                                        <Run Text="CPU" />
                                                        <Run Text="{Binding CpuUsagePercent, Converter={x:Static c:Conv.Percent}}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding CpuCount}" />
                                                        <Run Text="{l:Tr Common_Cores}" />
                                                    </TextBlock>
                                                    <ProgressBar Classes="usage" Value="{Binding CpuUsagePercent}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="4">
                                                    <TextBlock Classes="subtle" FontSize="11">
                                                        <Run Text="{l:Tr Common_Memory}" />
                                                        <Run>
                                                            <Run.Text>
                                                                <MultiBinding Converter="{x:Static c:Conv.UsedOf}">
                                                                    <Binding Path="MemBytes" />
                                                                    <Binding Path="MaxMemBytes" />
                                                                </MultiBinding>
                                                            </Run.Text>
                                                        </Run>
                                                    </TextBlock>
                                                    <ProgressBar Classes="usage">
                                                        <ProgressBar.Value>
                                                            <MultiBinding Converter="{x:Static c:Conv.Ratio}">
                                                                <Binding Path="MemBytes" />
                                                                <Binding Path="MaxMemBytes" />
                                                            </MultiBinding>
                                                        </ProgressBar.Value>
                                                    </ProgressBar>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </RefreshContainer>
    </ContentPage>

    <!-- 스토리지 -->
    <ContentPage Header="{l:Tr Cluster_TabStorage}">
        <RefreshContainer RefreshRequested="OnRefreshRequested">
            <ScrollViewer>
                <ItemsControl Margin="16,12,16,24" ItemsSource="{Binding Storages}"
                              ItemsPanel="{StaticResource CardListPanel}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:PveStorage">
                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Ellipse Classes="dot" Margin="0,0,12,0"
                                                 Fill="{Binding Status, Converter={x:Static c:Conv.StatusBrush}}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Classes="title" Text="{Binding Storage}" />
                                            <TextBlock Classes="subtle">
                                                <Run Text="{Binding Node}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding PluginType}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Classes="subtle" VerticalAlignment="Top"
                                                   Text="{Binding UsagePercent, Converter={x:Static c:Conv.Percent}}" />
                                    </Grid>
                                    <ProgressBar Classes="usage" Value="{Binding UsagePercent}" />
                                    <TextBlock Classes="subtle" FontSize="12">
                                        <Run>
                                            <Run.Text>
                                                <MultiBinding Converter="{x:Static c:Conv.UsedOf}">
                                                    <Binding Path="DiskBytes" />
                                                    <Binding Path="MaxDiskBytes" />
                                                </MultiBinding>
                                            </Run.Text>
                                        </Run>
                                    </TextBlock>
                                    <TextBlock Classes="subtle" FontSize="12" Text="{Binding Content}"
                                               TextWrapping="Wrap" TextTrimming="None" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </RefreshContainer>
    </ContentPage>

    <!-- 작업 -->
    <ContentPage Header="{l:Tr Cluster_TabTasks}">
        <RefreshContainer RefreshRequested="OnRefreshRequested">
            <ScrollViewer>
                <ItemsControl Margin="16,12,16,24" ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:PveTask">
                            <Border Classes="card" Padding="0">
                                <Button Classes="row"
                                        Command="{Binding $parent[ItemsControl].((vm:ClusterViewModel)DataContext).OpenTaskCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Ellipse Classes="dot" Margin="0,0,12,0" VerticalAlignment="Top"
                                                 Fill="{Binding Status, Converter={x:Static c:Conv.TaskBrush}}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Classes="title" FontSize="15"
                                                       Text="{Binding Converter={x:Static c:Conv.TaskTitle}}" />
                                            <TextBlock Classes="subtle">
                                                <Run Text="{Binding Node}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding User}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding StartTimeUtc, Converter={x:Static c:Conv.LocalTime}}" />
                                            </TextBlock>
                                            <TextBlock Classes="subtle" Foreground="{StaticResource DangerBrush}"
                                                       Text="{Binding Status}" IsVisible="{Binding IsFailed}"
                                                       TextWrapping="Wrap" TextTrimming="None" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </RefreshContainer>
    </ContentPage>
</TabbedPage>
