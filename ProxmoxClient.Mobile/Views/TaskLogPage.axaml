<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProxmoxClient.Mobile.ViewModels"
             xmlns:c="using:ProxmoxClient.Mobile.Converters"
             x:Class="ProxmoxClient.Mobile.Views.TaskLogPage"
             x:DataType="vm:TaskLogViewModel"
             Header="{Binding Title}">
    <Grid RowDefinitions="Auto,*">
        <Border Classes="card" Margin="16,12,16,8">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Classes="dot" Fill="{Binding TaskItem.Status, Converter={x:Static c:Conv.TaskBrush}}" />
                    <TextBlock Text="{Binding TaskItem.Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Classes="subtle">
                    <Run Text="{Binding TaskItem.Node}" />
                    <Run Text="·" />
                    <Run Text="{Binding TaskItem.User}" />
                    <Run Text="·" />
                    <Run Text="{Binding TaskItem.StartTimeUtc, Converter={x:Static c:Conv.LocalTime}}" />
                </TextBlock>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Classes="card" Margin="16,0,16,16" Padding="10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding LogText}" FontFamily="monospace" FontSize="12" />
            </ScrollViewer>
        </Border>
    </Grid>
</ContentPage>
