<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Proxmox Client</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.moonjm98.proxmoxclient</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.3</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>15.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/AppIcon.appiconset</string>
	<!-- 사내망(같은 Wi-Fi)의 Proxmox 서버에 붙으려면 iOS 14+ 로컬 네트워크 권한이 필요하다 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>같은 네트워크에 있는 Proxmox 서버에 연결합니다.</string>
	<!--
		ATS(NSAppTransportSecurity) 예외는 두지 않는다 — HTTP·웹소켓은 .NET 관리형 처리기(UseNativeHttpHandler=false,
		SocketsHttpHandler·ClientWebSocket)가 직접 소켓을 열어 ATS 를 거치지 않는다. 자체 서명 인증서는 앱이 지문(TOFU)으로 확인한다.
		권한 문구의 영어·한국어는 Resources/en.lproj · ko.lproj 의 InfoPlist.strings.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ko</string>
		<string>en</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad 멀티태스킹(분할 화면) — 창 크기가 바뀌어도 그대로 그린다 -->
	<key>UIRequiresFullScreen</key>
	<false/>
</dict>
</plist>
