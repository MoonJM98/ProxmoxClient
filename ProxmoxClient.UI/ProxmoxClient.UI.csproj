<Project Sdk="Microsoft.NET.Sdk">

    <!--
        모바일(Android) 공용 UI — Avalonia 12. 서버 통신·모델은 데스크톱과 같은 ProxmoxClient.Core 를 그대로 쓴다.
        플랫폼별 기능(비밀값 보관 등)은 Services 의 인터페이스로 받고, 각 헤드 프로젝트가 구현을 넣는다.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <RootNamespace>ProxmoxClient.UI</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
        <!-- WPF 앱과 같은 표(DataGrid) -->
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <!-- 콘솔 Tight JPEG 디코딩 — Avalonia.Skia 와 같은 버전 -->
        <PackageReference Include="SkiaSharp" Version="3.119.4" />
        <!-- 2단계 인증(TOTP) QR 코드 — WPF 앱과 같은 MIT 라이브러리 -->
        <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ProxmoxClient.Core\ProxmoxClient.Core.csproj" />
    </ItemGroup>

</Project>
