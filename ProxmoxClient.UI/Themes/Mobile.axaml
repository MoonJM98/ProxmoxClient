<!-- 모바일(Android) — WPF 와 같은 색·모양에 손가락으로 누르기 좋은 크기만 더한다 -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="44" />
    </Style>
    <!-- 손가락 크기 — 단추·토글·선택 칸은 48×48 이상(Android 권장 누름 영역, 스크롤 막대의 작은 단추는 제외) -->
    <Style Selector="Button, ToggleButton, RadioButton">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="48" />
    </Style>
    <Style Selector="CheckBox, ToggleSwitch">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="48" />
    </Style>
    <!-- 휴대폰은 폭이 좁아 한 줄로 두면 긴 이름(볼륨 ID·파일 이름)이 '…'로 잘린다 — 줄을 바꿔 다 보인다 -->
    <Style Selector="TextBlock.title, TextBlock.subtle">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="DataGrid">
        <Setter Property="RowHeight" Value="40" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="MinHeight" Value="40" />
    </Style>
</Styles>
