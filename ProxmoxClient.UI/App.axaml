<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ProxmoxClient.UI.App"
             RequestedThemeVariant="Dark">
    <!-- WPF 앱과 같은 어두운 테마(항상) -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ProxmoxClient.UI/Themes/Icons.axaml" />
                <ResourceInclude Source="avares://ProxmoxClient.UI/Themes/Templates.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E5E8" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280" />
                    <SolidColorBrush x:Key="TrackBrush" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#FDECEA" />
                </ResourceDictionary>
                <!-- WPF DarkTheme 과 같은 값(BrushBg · BrushPanel · BrushBorder · BrushDim · BrushControl) -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#252526" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#3F3F46" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9E9E9E" />
                    <SolidColorBrush x:Key="TrackBrush" Color="#333337" />
                    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#3A1F1C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E5534B" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- 강조색은 데스크톱 앱과 같은 파랑 -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#007ACC" />
                <ColorPaletteResources x:Key="Dark" Accent="#007ACC" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://ProxmoxClient.UI/Themes/Styles.axaml" />
        <StyleInclude Source="avares://ProxmoxClient.UI/Themes/WpfTheme.axaml" />
    </Application.Styles>
</Application>
