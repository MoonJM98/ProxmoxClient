<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ProxmoxClient.UI.Views"
             xmlns:vm="using:ProxmoxClient.UI.ViewModels"
             xmlns:c="using:ProxmoxClient.UI.Converters"
             xmlns:l="using:ProxmoxClient.UI.Localization"
             x:Class="ProxmoxClient.UI.Views.NodeDetailPage"
             x:DataType="vm:NodeDetailViewModel"
             Header="{Binding Title}">

    <NavigationPage.TopCommandBar>
        <Button Classes="icon" Command="{Binding ReloadCommand}">
            <Path Classes="icon" Data="{StaticResource IconRefresh}" />
        </Button>
    </NavigationPage.TopCommandBar>

    <views:NodeDetailView />
</ContentPage>
