<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>ProxmoxClient.Droid</RootNamespace>
        <ApplicationId>io.github.moonjm98.proxmoxclient</ApplicationId>
        <ApplicationTitle>Proxmox Client</ApplicationTitle>
        <!--
            버전 — 보이는 버전은 $(Version)(기본 1.0.3, 빌드 때 -p:Version=1.2.0 으로 바꾼다).
            스토어용 정수 버전(versionCode)은 -p:VersionCode=... 또는 환경 변수 VERSION_CODE, 없으면 보이는 버전으로 계산한다
            (1.0.3 → 10003, 주·부·수 = 주×10000 + 부×100 + 수).
        -->
        <Version Condition="'$(Version)' == '' Or '$(Version)' == '1.0.0'">1.0.3</Version>
        <VersionCode Condition="'$(VersionCode)' == '' And '$(VERSION_CODE)' != ''">$(VERSION_CODE)</VersionCode>
        <_VersionCore>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+(\.\d+){0,2}').Value)</_VersionCore>
        <_VersionCore Condition="'$(_VersionCore)' == ''">1.0.3</_VersionCore>
        <_VersionCore>$(_VersionCore).0.0</_VersionCore>
        <VersionCode Condition="'$(VersionCode)' == ''">$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(_VersionCore.Split('.')[0]), 10000)), $([MSBuild]::Multiply($(_VersionCore.Split('.')[1]), 100)))), $(_VersionCore.Split('.')[2])))</VersionCode>
        <ApplicationVersion>$(VersionCode)</ApplicationVersion>
        <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
        <AndroidPackageFormat Condition="'$(AndroidPackageFormat)' == ''">apk</AndroidPackageFormat>
        <!--
            지연 최소화:
            - 전체 AOT(프로파일 AOT 끔) — 모든 코드를 미리 기계어로 컴파일해 실행 중 JIT 로 멈칫하는 일이 없다(APK 는 커진다).
            - HTTP 는 .NET 관리형 처리기(SocketsHttpHandler) — 데스크톱과 같은 코드 경로라 연결 재사용·인증서 고정(TOFU)·
              SOCKS5 프록시가 똑같이 동작한다(Android 기본 처리기는 Java HttpURLConnection 을 거친다).
        -->
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <UseNativeHttpHandler>false</UseNativeHttpHandler>
        <!-- 실제 기기 대부분(arm64)과 에뮬레이터(x64)만 — 32비트 ABI 는 APK 크기만 키운다 -->
        <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <!--
        배포(Release) APK 는 arm64 만 — 하나에 arm64·x64 를 다 넣으면 어셈블리(글꼴 내장 포함)·네이티브 라이브러리가
        ABI 마다 들어가 크기가 두 배가 된다(.NET 10 Android 는 ABI 별 APK 나누기(AndroidCreatePackagePerAbi)를 지원하지 않는다).
        에뮬레이터·x64 기기용 배포 APK 가 필요하면 -p:RuntimeIdentifiers=android-x64 로 따로 만든다.
        스토어용 AAB(-p:AndroidPackageFormat=aab)는 두 ABI 를 다 넣는다 — 스토어가 기기에 맞는 것만 내려 준다.
        디버그는 그대로 둘 다(실기기 + 에뮬레이터).
    -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(AndroidPackageFormat)' == 'apk'">
        <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <!--
        배포 서명 — 환경 변수(또는 같은 이름의 -p: 속성)가 있을 때만. 키 파일·비밀번호는 저장소에 넣지 않는다.
          ANDROID_KEYSTORE_PATH  ANDROID_KEYSTORE_PASSWORD  ANDROID_KEY_ALIAS  ANDROID_KEY_PASSWORD(없으면 키스토어 비밀번호)
        없으면 디버그 키로 서명한다(설치·시험용).
    -->
    <PropertyGroup Condition="'$(ANDROID_KEYSTORE_PATH)' != ''">
        <AndroidKeyStore>true</AndroidKeyStore>
        <AndroidSigningKeyStore>$(ANDROID_KEYSTORE_PATH)</AndroidSigningKeyStore>
        <AndroidSigningStorePass>env:ANDROID_KEYSTORE_PASSWORD</AndroidSigningStorePass>
        <AndroidSigningKeyAlias>$(ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
        <AndroidSigningKeyPass Condition="'$(ANDROID_KEY_PASSWORD)' != ''">env:ANDROID_KEY_PASSWORD</AndroidSigningKeyPass>
        <AndroidSigningKeyPass Condition="'$(ANDROID_KEY_PASSWORD)' == ''">env:ANDROID_KEYSTORE_PASSWORD</AndroidSigningKeyPass>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ProxmoxClient.UI\ProxmoxClient.UI.csproj" />
    </ItemGroup>

</Project>
