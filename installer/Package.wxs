<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

    <!--
        Proxmox Client 설치 관리자.
        UpgradeCode 는 제품의 영구 식별자다 — 바꾸면 기존 설치본을 덮어쓰지 못하고 따로 설치되므로 고정한다.
    -->
    <Package Name="Proxmox Client"
             Manufacturer="ProxmoxClient Contributors"
             Version="$(ProductVersion)"
             UpgradeCode="2F4848BC-0938-4DAF-9378-C805DA549D7A"
             Scope="perMachine"
             Compressed="yes"
             InstallerVersion="500">

        <MajorUpgrade DowngradeErrorMessage="이미 최신 버전의 [ProductName] 이(가) 설치되어 있습니다."/>
        <MediaTemplate EmbedCab="yes"/>

        <Icon Id="AppIcon" SourceFile="$(PublishDir)\ProxmoxClient.App.exe"/>
        <Property Id="ARPPRODUCTICON" Value="AppIcon"/>
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/microsoft/terminal"/>
        <Property Id="ARPNOREPAIR" Value="1"/>

        <!-- 프레임워크 종속 배포라 .NET 10 데스크톱 런타임이 필요하다 -->
        <Property Id="DOTNETDESKTOP10">
            <RegistrySearch Id="SearchDotNetDesktop10"
                            Root="HKLM"
                            Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App"
                            Name="Version"
                            Type="raw"/>
        </Property>

        <Launch Condition="Installed OR DOTNETDESKTOP10"
                Message="이 프로그램에는 .NET 10 데스크톱 런타임이 필요합니다. https://dotnet.microsoft.com/download/dotnet/10.0 에서 설치한 뒤 다시 실행해 주세요."/>

        <StandardDirectory Id="ProgramFiles6432Folder">
            <Directory Id="INSTALLFOLDER" Name="Proxmox Client"/>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="AppMenuFolder" Name="Proxmox Client"/>
        </StandardDirectory>

        <Feature Id="Main" Title="Proxmox Client" Level="1">
            <ComponentGroupRef Id="AppFiles"/>
            <ComponentRef Id="StartMenuShortcut"/>
        </Feature>

    </Package>

    <!-- 게시 폴더 전체를 그대로 담는다(하위 폴더 runtimes\, en\, third-party\ 포함) -->
    <Fragment>
        <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
            <Files Include="$(PublishDir)\**"/>
        </ComponentGroup>
    </Fragment>

    <Fragment>
        <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="7C1D0E52-3B94-4A6E-9F21-5D8A4E6B0C13">
            <Shortcut Id="AppShortcut"
                      Name="Proxmox Client"
                      Description="Proxmox Virtual Environment 관리 도구"
                      Target="[INSTALLFOLDER]ProxmoxClient.App.exe"
                      WorkingDirectory="INSTALLFOLDER"/>
            <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall"/>
            <!-- 바로가기는 사용자 프로필 영역이라 KeyPath 를 HKCU 에 두어야 한다(ICE38/43/57) -->
            <RegistryValue Root="HKCU"
                           Key="Software\ProxmoxClient Contributors\Proxmox Client"
                           Name="StartMenuShortcut"
                           Type="integer"
                           Value="1"
                           KeyPath="yes"/>
        </Component>
    </Fragment>

</Wix>
