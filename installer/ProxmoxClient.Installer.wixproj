<Project Sdk="WixToolset.Sdk/7.0.0">

    <PropertyGroup>
        <!-- OutputName 이 참조하므로 버전을 먼저 정의한다(MSBuild 는 순차 평가) -->
        <ProductVersion>1.0.0</ProductVersion>
        <OutputName>ProxmoxClient-$(ProductVersion)</OutputName>
        <OutputType>Package</OutputType>
        <!-- 게시 산출물을 그대로 담는다 — 앱을 먼저 dotnet publish 해 두어야 한다 -->
        <PublishDir>$(MSBuildThisFileDirectory)..\publish</PublishDir>
        <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(ProductVersion)</DefineConstants>
        <!--
            WiX v6 부터 Open Source Maintenance Fee(OSMF) 가 적용되어 EULA 수락이 필요하다.
            연매출 $10,000 을 넘는 조직이 사용한다면 wixtoolset GitHub 스폰서 후원 의무가 생긴다.
            https://docs.firegiant.com/wix/osmf/
        -->
        <AcceptEula>wix7</AcceptEula>
    </PropertyGroup>

    <ItemGroup>
        <BindPath Include="$(PublishDir)"/>
    </ItemGroup>

</Project>
