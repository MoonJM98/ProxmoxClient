<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- 저장소에 동봉한 패키지(packages/) — 외부에서 내려가도 빌드가 깨지지 않게 한다 -->
    <add key="vendored" value="packages" />
  </packageSources>

  <!--
    터미널 컨트롤은 저장소에 담은 패키지에서만 가져온다(외부 조회 없음).
    Microsoft 가 이 컨트롤을 nuget.org 에 게시하지 않으므로 MIT 바이너리를 직접 담아 쓴다.
  -->
  <packageSourceMapping>
    <packageSource key="vendored">
      <package pattern="ProxmoxClient.Vendored.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
